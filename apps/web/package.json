{
  "name": "web",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf .astro .wrangler dist node_modules",
    "dev:static": "dotenvx run -f ../../.env.local -f ../../.env -- astro dev --port 4321",
    "dev:preview": "dotenvx run -f ../../.env.local -f ../../.env --env PREVIEW=true --env CLOUDFLARE_ENV=preview -- astro dev --port 4322",
    "dev": "concurrently -n preview,static -c green,blue \"pnpm dev:preview\" \"pnpm dev:static\"",
    "build:static": "dotenvx run -f ../../.env -- astro build",
    "build:preview": "dotenvx run -f ../../.env --env PREVIEW=true --env CLOUDFLARE_ENV=preview -- astro build",
    "build": "pnpm build:static && pnpm build:preview",
    "preview:static": "astro preview --outDir dist/static",
    "deploy:static": "wrangler deploy -c ./wrangler.jsonc --env production",
    "deploy:preview": "wrangler deploy -c ./dist/preview/server/wrangler.json --env preview",
    "astro": "astro",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"./src/**/*.{css,astro}\"",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@repo/services": "workspace:*",
    "@repo/utils": "workspace:*",
    "astro": "^7.1.3",
    "wrangler": "^4.114.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.4",
    "eslint": "catalog:",
    "eslint-config": "workspace:*",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1"
  }
}
