{
  "name": "web",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf .astro .wrangler dist node_modules",
    "dev:static": "dotenvx run -f ../../.env.local -f ../../.env -- astro dev --port 4321",
    "dev:ssr": "dotenvx run -f ../../.env.local -f ../../.env --env SSR_BUILD=true --env CLOUDFLARE_ENV=ssr -- astro dev --port 4322",
    "dev": "concurrently -n ssr,static -c green,blue \"pnpm dev:ssr\" \"pnpm dev:static\"",
    "build:static": "dotenvx run -f ../../.env -- astro build && node ./scripts/assertBundledImages.js ./dist/static",
    "build:ssr": "dotenvx run -f ../../.env --env SSR_BUILD=true --env CLOUDFLARE_ENV=ssr -- astro build",
    "build": "pnpm build:static && pnpm build:ssr",
    "preview:static": "astro preview --outDir dist/static",
    "deploy:static": "wrangler deploy -c ./wrangler.jsonc --env static",
    "deploy:ssr": "wrangler deploy -c ./dist/ssr/server/wrangler.json",
    "astro": "astro",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"./src/**/*.{css,astro}\"",
    "tsc": "pnpm generate-types && astro check",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@repo/services": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "astro": "catalog:",
    "i18next": "^26.3.6",
    "wrangler": "^4.114.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@dotenvx/dotenvx": "catalog:",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.4",
    "eslint": "catalog:",
    "eslint-config": "workspace:*",
    "postcss-html": "^1.8.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "catalog:"
  }
}
