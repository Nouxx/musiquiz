{
  // base config, never deployed on its own — every deploy targets an env below
  "name": "musiquiz",
  "account_id": "a98829785d9ad4b7960ca91370b92848",
  "compatibility_date": "2026-06-23",
  "env": {
    // triggered by CLOUDFLARE_ENV at build time
    // https://developers.cloudflare.com/workers/wrangler/environments/
    "static": {
      "name": "musiquiz-static",
      // the static build ships its own output as assets, there is no worker script
      "assets": {
        "directory": "./dist/static",
        "not_found_handling": "404-page" // https://developers.cloudflare.com/workers/static-assets/routing/static-site-generation/
      }
    },
    "ssr": {
      "name": "musiquiz-ssr",
      // @astrojs/cloudflare injects an id-less SESSION binding unless one is
      // declared here, which would force wrangler to provision a namespace at
      // deploy time — it cannot in a non-interactive CI runner
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "d4454eae843640eabf44e3d5a8c45f45"
        }
      ]
    }
  }
}
