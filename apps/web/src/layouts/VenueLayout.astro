---
import VenueHeader from "../components/features/VenueHeader.astro";
import type { Props as SeoProps } from "../components/features/SeoHead.astro";
import Layout from "./Layout.astro";

interface Props extends SeoProps {
  venueSlug: string;
}

const { venueSlug, ...seo } = Astro.props;
---

<Layout {...seo}>
  <slot name="head" slot="head" />
  <VenueHeader {venueSlug} />

  <slot />
</Layout>
