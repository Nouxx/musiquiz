---
import type { Lang } from "@repo/utils/lang";
import { getHomepageData } from "@repo/services/cms/getHomepageData";
import { getFooterData } from "@repo/services/cms/getFooterData";
import HomepageCover from "../features/HomepageCover.astro";
import VenuesList from "../features/VenuesList.astro";
import GlobalFooter from "../features/GlobalFooter.astro";

interface Props {
  lang: Lang;
  projectId: string;
  dataset: string;
  draft: boolean;
  token?: string;
}

const { lang, projectId, dataset, draft, token } = Astro.props;

const pageData = await getHomepageData({
  lang,
  projectId,
  dataset,
  draft,
  token,
});

const footerData = await getFooterData({
  projectId,
  dataset,
  draft,
  token,
});
---

<HomepageCover
  logo={pageData.logo}
  badgeLabel={pageData.badgeLabel}
  heading={pageData.heading}
/>

<div style={{ border: "1px solid black", margin: "2px" }}>
  <p>TODO: PageComponent[]</p>
</div>

<VenuesList venues={pageData.venues} />

<GlobalFooter data={footerData} lang={lang} />
