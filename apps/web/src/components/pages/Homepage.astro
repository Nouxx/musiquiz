---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type { Homepage as HomepageData } from "@repo/services/cms/types";
import PageComponents from "../features/PageComponents.astro";
import HomepageCover from "../features/HomepageCover.astro";
import VenuesList from "../features/VenuesList.astro";
import Footer from "../features/Footer.astro";
import Header from "../features/Header.astro";

interface Props {
  data: HomepageData;
  alternates: Alternates;
}

const { data, alternates } = Astro.props;
---

<Header {alternates} />

<HomepageCover
  logo={data.logo}
  cover={data.cover}
  badgeLabel={data.badgeLabel}
  heading={data.heading}
/>

<PageComponents components={data.components} />

<VenuesList venues={data.venues} cta={data.venuesCta} />

<Footer {alternates} />
