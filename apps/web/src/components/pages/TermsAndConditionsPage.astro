---
import { venueTermsAnchor } from "@repo/services/routing/anchors";
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type { TermsAndConditionsPage as TermsAndConditionsPageData } from "@repo/services/cms/types";
import VenueTerms from "@repo/ui/VenueTerms";

import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";
import Footer from "../features/Footer.astro";
import CmsPageCover from "../features/CmsPageCover.astro";

interface Props {
  data: TermsAndConditionsPageData;
  alternates: Alternates;
}

const lang = getLang(Astro);
const t = getT(lang);

const { data, alternates } = Astro.props;
const { pageCover, intro, venues } = data;
---

<CmsPageCover data={pageCover} height="m" />

<VenueTerms
  indexLabel={t("termsAndConditionsPage.indexLabel")}
  {intro}
  venues={venues.map((venue) => ({
    id: venueTermsAnchor(venue.slug),
    title: t("termsAndConditionsPage.venueTitle", { venue: venue.title }),
    articles: venue.articles.map((article, index) => ({
      title: t("termsAndConditionsPage.articleTitle", {
        number: index + 1,
        title: article.title,
      }),
      body: article.body,
    })),
  }))}
/>

<Footer {alternates} />
