---
import { getLang } from "../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import VenueFooter from "../features/VenueFooter.astro";
import VenuePageCover from "../features/VenuePageCover.astro";
import PageComponents from "../features/PageComponents.astro";
import { getVenueGamePageData } from "@repo/services/cms/getVenueGamePageData";

interface Props {
  venueSlug: string;
  gameSlug: string;
}

const { venueSlug, gameSlug } = Astro.props;

const lang = getLang(Astro);

const pageData = await getVenueGamePageData({
  lang,
  venueSlug,
  gameSlug,
  config: getSanityConfigFromEnvironment(),
});
---

<VenuePageCover data={pageData.pageCover} />

<PageComponents components={pageData.components} />

<VenueFooter {venueSlug} />
