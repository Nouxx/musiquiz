---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type { BlogPage as BlogPageData } from "@repo/services/cms/types";

import BlogListing from "../features/BlogListing.astro";
import Footer from "../features/Footer.astro";
import Header from "../features/Header.astro";

export interface Props {
  data: BlogPageData;
  page: number;
  alternates: Alternates;
}

const { data, page, alternates } = Astro.props;
---

<Header {alternates} />

<BlogListing
  title={data.title}
  intro={data.intro}
  articles={data.articles}
  {page}
/>

<Footer {alternates} />
