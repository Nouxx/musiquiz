---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type {
  JoinTheNetworkPage as JoinTheNetworkPageData,
  PageCover as PageCoverData,
} from "@repo/services/cms/types";
import { anchors } from "@repo/services/routing/anchors";

import { getLang } from "../../libs/getLang";
import Footer from "../features/Footer.astro";
import Header from "../features/Header.astro";
import PageComponents from "../features/PageComponents.astro";
import VenueOpeningForm from "../features/VenueOpeningForm.astro";
import CmsPageCover from "../features/CmsPageCover.astro";
import { getT } from "../../libs/i18n";

interface Props {
  data: JoinTheNetworkPageData;
  alternates: Alternates;
}

const lang = getLang(Astro);
const t = getT(lang);

const { data, alternates } = Astro.props;

const pageCoverData: PageCoverData = {
  ...data.pageCover,
  cta: {
    label: t("joinTheNetworkPage.ctaLabel"),
    url: `#${anchors.venueOpeningForm}`,
  },
};
---

<Header {alternates} />

<CmsPageCover data={pageCoverData} height="full" ctaIcon="arrow-down" />

<PageComponents components={data.components} />

<VenueOpeningForm />

<Footer {alternates} />
