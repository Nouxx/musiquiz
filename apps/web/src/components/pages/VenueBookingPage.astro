---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";
import VenueFooter from "../features/VenueFooter.astro";
import CmsPageCover from "../features/CmsPageCover.astro";
import PageComponents from "../features/PageComponents.astro";
import type {
  PageCover as PageCoverData,
  VenueWidgetPage,
} from "@repo/services/cms/types";
import Widget from "../features/4espace/Widget.astro";
import { anchors } from "@repo/services/routing/anchors";

interface Props {
  venueSlug: string;
  data: VenueWidgetPage;
  alternates: Alternates;
}

const { venueSlug, data, alternates } = Astro.props;

const lang = getLang(Astro);
const t = getT(lang);

const pageCoverData: PageCoverData = {
  ...data.pageCover,
  cta: {
    label: t("venueBookingPage.ctaLabel"),
    url: `#${anchors.booking}`,
  },
  secondaryCta: {
    label: t("venueBookingPage.secondaryCtaLabel"),
    url: `#${anchors.prices}`,
  },
};
---

<CmsPageCover data={pageCoverData} />

<PageComponents components={data.componentsBeforeWidget} />

<Widget
  anchor={anchors.booking}
  widgetId={data.widgetId}
  settings={data.forEscapeSettings}
/>

<PageComponents components={data.componentsAfterWidget} />

<VenueFooter {venueSlug} {alternates} />
