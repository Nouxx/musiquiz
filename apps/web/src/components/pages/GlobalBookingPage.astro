---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type {
  GlobalBookingPage as GlobalBookingPageData,
  PageCover as PageCoverData,
} from "@repo/services/cms/types";
import { venuesMapAnchorId } from "@repo/ui/types";

import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";
import Footer from "../features/Footer.astro";
import Header from "../features/Header.astro";
import VenuePageCover from "../features/VenuePageCover.astro";
import VenuesList from "../features/VenuesList.astro";

interface Props {
  data: GlobalBookingPageData;
  alternates: Alternates;
}

const lang = getLang(Astro);
const t = getT(lang);

const { data, alternates } = Astro.props;

const pageCoverData: PageCoverData = {
  ...data.pageCover,
  cta: {
    label: t("globalBookingPage.ctaLabel"),
    url: `#${venuesMapAnchorId}`,
  },
};
---

<Header {alternates} />

<VenuePageCover data={pageCoverData} ctaIcon="arrow-down" />

<VenuesList
  venues={data.venues}
  cta={undefined}
  badge={t("globalBookingPage.venuesBadge")}
  heading={t("globalBookingPage.venuesHeading")}
/>

<Footer {alternates} />
