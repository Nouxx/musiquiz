---
import { getLang } from "../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getRoutesForLang } from "../../routing/routes";
import VenueFooter from "../features/VenueFooter.astro";
import VenueHomepageCover from "../features/VenueHomepageCover.astro";
import { getVenueHomepageData } from "@repo/services/cms/getVenueHomepageData";

interface Props {
  venueSlug: string;
}

const { venueSlug } = Astro.props;

const lang = getLang(Astro);

const routes = getRoutesForLang(lang);

const pageData = await getVenueHomepageData({
  lang,
  venueSlug,
  config: getSanityConfigFromEnvironment(),
});
---

<VenueHomepageCover
  media={pageData.pageCover.media}
  badgeLabel={pageData.pageCover.badge}
  heading={pageData.pageCover.heading}
  subHeading={pageData.pageCover.subHeading}
  cta={pageData.pageCover.ctaLabel
    ? {
        label: pageData.pageCover.ctaLabel,
        url: routes.venueBook(venueSlug),
      }
    : undefined}
/>

<VenueFooter {venueSlug} />
