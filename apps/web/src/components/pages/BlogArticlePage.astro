---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";
import type { BlogArticlePage as BlogArticlePageData } from "@repo/services/cms/types";
import ArticleAuthor from "@repo/ui/ArticleAuthor";
import ArticleBody from "@repo/ui/ArticleBody";
import ArticleIntro from "@repo/ui/ArticleIntro";
import Faq from "@repo/ui/Faq";
import FindUs from "@repo/ui/FindUs";
import RelatedArticles from "@repo/ui/RelatedArticles";
import type { BreadcrumbItem } from "@repo/ui/types";

import { getT } from "../../libs/i18n";
import { formatBlogDate, toArticleCard } from "../../libs/toArticleCard";
import { toContactFacts } from "../../libs/toContactFacts";
import ArticleCover from "../features/ArticleCover.astro";
import Footer from "../features/Footer.astro";
import Header from "../features/Header.astro";
import { CARTO_API_KEY } from "astro:env/client";

export interface Props {
  data: BlogArticlePageData;
  breadcrumbs: BreadcrumbItem[];
  alternates: Alternates;
}

const { data, breadcrumbs, alternates } = Astro.props;

const t = getT("fr");
const routes = getRoutesForLang("fr");

const articleAnchor = "article";
const { closesOn } = data;

function toClosingCta() {
  if (closesOn.kind === "venue") {
    return {
      label: t("blogArticlePage.book", { venue: closesOn.title }),
      ...closesOn.bookingLink,
    };
  }
  if (closesOn.kind === "event") {
    return {
      label: t("blogArticlePage.seeEvent", { event: closesOn.title }),
      url: routes.event(closesOn.slug),
    };
  }
  return { label: t("blogArticlePage.findVenue"), url: routes.whereToFindUs };
}

const date = data.updatedAt
  ? { key: "blogArticlePage.updated" as const, iso: data.updatedAt }
  : { key: "blogArticlePage.published" as const, iso: data.publishedAt };
---

<Header {alternates} />

<ArticleCover
  items={breadcrumbs}
  breadcrumbsLabel={t("blogArticlePage.breadcrumbs")}
  media={data.cover}
  title={data.title}
  cta={{ label: t("blogPage.readArticle"), url: `#${articleAnchor}` }}
  photo={data.author.photo}
  name={data.author.name}
  date={{
    label: t(date.key, { date: formatBlogDate(date.iso) }),
    iso: date.iso,
  }}
  readingTime={t("blogArticlePage.readingTime", { count: data.readingMinutes })}
/>

<ArticleIntro
  summaryBadge={t("blogArticlePage.summary")}
  summary={data.summary}
  chips={data.chips}
  rating={data.reviewCount === undefined
    ? undefined
    : {
        label: t("blogArticlePage.rating", { count: data.reviewCount }),
        starsLabel: t("blogArticlePage.ratingStars"),
      }}
  cta={toClosingCta()}
/>

<ArticleBody id={articleAnchor} nodes={data.body} />

{
  closesOn.kind === "venue" && (
    <FindUs
      media={closesOn.findUs.media}
      badge={closesOn.findUs.badge}
      title={closesOn.findUs.title}
      facts={toContactFacts({ component: closesOn.findUs, t })}
      cta={{
        label: t("blogArticlePage.findUsCta", { venue: closesOn.title }),
        ...closesOn.bookingLink,
      }}
      map={{
        ...closesOn.findUs.location,
        title: t("findUs.mapTitle", { venue: closesOn.title }),
        apiKey: CARTO_API_KEY,
      }}
    />
  )
}

{
  data.faq && (
    <Faq
      badge={t("faq.badge")}
      title={data.faq.title}
      questions={data.faq.questions}
    />
  )
}

<ArticleAuthor
  badge={t("blogArticlePage.author")}
  name={data.author.name}
  jobTitle={data.author.jobTitle}
  bio={data.author.bio}
  photo={data.author.photo}
/>

{
  data.readMore.length > 0 && (
    <RelatedArticles
      title={
        closesOn.kind === "venue"
          ? t("blogArticlePage.readMoreVenue", { venue: closesOn.title })
          : t("blogArticlePage.readMore")
      }
      articles={data.readMore.map(toArticleCard)}
    />
  )
}

<Footer {alternates} />
