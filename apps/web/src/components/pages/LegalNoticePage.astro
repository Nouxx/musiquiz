---
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type { LegalNoticePage as LegalNoticePageData } from "@repo/services/cms/types";
import TextBody from "@repo/ui/TextBody";

import Footer from "../features/Footer.astro";
import VenuePageCover from "../features/VenuePageCover.astro";

interface Props {
  data: LegalNoticePageData;
  alternates: Alternates;
}

const { data, alternates } = Astro.props;
---

<VenuePageCover data={data.pageCover} height="m" />

<TextBody body={data.body} />

<Footer {alternates} />
