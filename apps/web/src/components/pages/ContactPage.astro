---
import { getContactPageData } from "@repo/services/cms/getContactPageData";
import type { PageCover as PageCoverData } from "@repo/services/cms/types";
import TeamMembers from "@repo/ui/TeamMembers";
import VenuesContact from "@repo/ui/VenuesContact";

import { getLang } from "../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getT } from "../../libs/i18n";
import Footer from "../features/Footer.astro";
import VenuePageCover from "../features/VenuePageCover.astro";

const lang = getLang(Astro);
const t = getT(lang);

const { pageCover, team, venues } = await getContactPageData({
  lang,
  config: getSanityConfigFromEnvironment(),
});

const venuesContactAnchor = "venues-contact";

const pageCoverData: PageCoverData = pageCover.cta
  ? {
      ...pageCover,
      cta: { ...pageCover.cta, url: `#${venuesContactAnchor}` },
    }
  : pageCover;
---

<VenuePageCover data={pageCoverData} height="m" ctaIcon="arrow-down" />

<TeamMembers
  title={team.title}
  intro={team.intro}
  members={team.members}
  mailAriaLabel={t("contactPage.writeTo")}
/>

<VenuesContact
  id={venuesContactAnchor}
  title={venues.title}
  intro={venues.intro}
  venues={venues.items.map((venue) => ({
    ...venue,
    city: venue.title,
    name: t("contactPage.venueName", { city: venue.title }),
  }))}
/>

<Footer />
