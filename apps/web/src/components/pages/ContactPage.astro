---
import { anchors } from "@repo/services/routing/anchors";
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type {
  ContactPage as ContactPageData,
  PageCover as PageCoverData,
} from "@repo/services/cms/types";
import TeamMembers from "@repo/ui/TeamMembers";
import VenuesContact from "@repo/ui/VenuesContact";

import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";
import Footer from "../features/Footer.astro";
import Header from "../features/Header.astro";
import CmsPageCover from "../features/CmsPageCover.astro";

interface Props {
  data: ContactPageData;
  alternates: Alternates;
}

const lang = getLang(Astro);
const t = getT(lang);

const { data, alternates } = Astro.props;
const { pageCover, team, venues } = data;

const pageCoverDataWithCta: PageCoverData = {
  ...pageCover,
  cta: { label: t("contactPage.ctaLabel"), url: `#${anchors.venuesContact}` },
};
---

<Header {alternates} />

<CmsPageCover data={pageCoverDataWithCta} height="m" ctaIcon="arrow-down" />

<TeamMembers
  title={team.title}
  intro={team.intro}
  members={team.members}
  mailAriaLabel={t("contactPage.writeTo")}
/>

<VenuesContact
  id={anchors.venuesContact}
  title={venues.title}
  intro={venues.intro}
  venues={venues.items.map((venue) => ({
    ...venue,
    city: venue.title,
    name: t("contactPage.venueName", { city: venue.title }),
  }))}
/>

<Footer {alternates} />
