---
import type { Organization } from "@repo/services/cms/types";
import { toInlineScriptJson } from "@repo/utils/toInlineScriptJson";

import { getOrganizationId } from "../../libs/getOrganizationId";
import { getOrganizationLogoUrl } from "../../libs/getOrganizationLogoUrl";
import { getSite } from "../../libs/getSite";

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;

const site = getSite(Astro);
const organizationId = getOrganizationId(site);

const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: "Musi'Quiz",
  url: site.href,
  logo: await getOrganizationLogoUrl(site, organization.logo),
  sameAs: organization.sameAs,
  telephone: organization.telephone,
  email: organization.email,
};

const webSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Musi'Quiz",
  url: site.href,
  publisher: { "@id": organizationId },
};

const structuredData = toInlineScriptJson([organizationData, webSite]);
---

<script is:inline type="application/ld+json" set:html={structuredData} />
