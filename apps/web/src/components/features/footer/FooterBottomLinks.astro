---
import Link from "@repo/ui/primitives/Link";
import Text from "@repo/ui/primitives/Text";

import { getLang } from "../../../libs/getLang";
import { getT } from "../../../libs/i18n";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";

const lang = getLang(Astro);

const t = getT(lang);

const routes = getRoutesForLang(lang);

const legalLinks = [
  { label: t("footer.termsAndConditions"), url: routes.termsAndConditions },
  { label: t("footer.legalNotice"), url: routes.legalNotice },
];
---

{
  legalLinks.map((link) => (
    <li>
      <Link url={link.url} underline={false}>
        <Text variant="paragraph-s">{link.label}</Text>
      </Link>
    </li>
  ))
}
