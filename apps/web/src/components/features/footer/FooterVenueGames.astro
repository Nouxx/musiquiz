---
import type { VenueFooter } from "@repo/services/cms/types";
import Flex from "@repo/ui/primitives/Flex";
import Text from "@repo/ui/primitives/Text";
import Link from "@repo/ui/primitives/Link";
import { getLang } from "../../../libs/getLang";
import { getT } from "../../../libs/i18n";
import { getRoutesForLang } from "../../../routing/routes";

interface Props {
  venueSlug: string;
  games: VenueFooter["games"];
}

const { venueSlug, games } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);

const gamesWithLink = games.map((game) => ({
  ...game,
  url: getRoutesForLang(lang).venueGame(venueSlug, game.slug),
}));
---

<Flex direction="column">
  <Text variant="paragraph-base-sm">
    {t("footer.ourVenueGames")}
  </Text>
  {
    gamesWithLink.length > 0 &&
      gamesWithLink.map((game) => <Link url={game.url}>{game.label}</Link>)
  }
</Flex>
