---
import FooterColumn from "@repo/ui/footer/FooterColumn";
import Newsletter from "@repo/ui/footer/Newsletter";
import Button from "@repo/ui/primitives/Button";
import Checkbox from "@repo/ui/primitives/Checkbox";
import TextField from "@repo/ui/primitives/TextField";

import { getLang } from "../../../libs/getLang";
import { getT } from "../../../libs/i18n";

const t = getT(getLang(Astro));
---

{
  /* the form is inert: `Newsletter` swallows the submit until a subscription
    endpoint exists */
}
<FooterColumn heading={t("footer.subscribe")} gap="6">
  <Newsletter>
    <TextField
      id="newsletter-mail"
      name="mail"
      type="email"
      label={t("footer.mailAddress")}
      placeholder={t("footer.mailPlaceholder")}
      required
    />
    <Checkbox slot="consent" id="newsletter-consent" name="consent" required>
      {t("footer.newsletterConsent")}
    </Checkbox>
    <Button slot="cta" type="submit" tone="red" size="m">
      {t("footer.subscribeCta")}
    </Button>
  </Newsletter>
</FooterColumn>
