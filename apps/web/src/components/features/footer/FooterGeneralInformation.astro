---
import FooterColumn from "@repo/ui/footer/FooterColumn";
import Link from "@repo/ui/primitives/Link";
import Text from "@repo/ui/primitives/Text";

import { getLang } from "../../../libs/getLang";
import { getT } from "../../../libs/i18n";
import FooterChangeLang from "./FooterChangeLang.astro";
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);

const routes = getRoutesForLang(lang);

const links = [
  { label: t("footer.whereToFindUs"), url: routes.whereToFindUs },
  { label: t("footer.contact"), url: routes.contact },
  { label: t("footer.joinTheNetwork"), url: routes.joinTheNetwork },
  ...("blog" in routes ? [{ label: t("footer.blog"), url: routes.blog }] : []),
  { label: t("footer.press"), url: routes.press },
];
---

<FooterColumn
  heading={t("footer.generalInformation")}
  as="ul"
  gap="1"
  tone="muted"
>
  {
    links.map((link) => (
      <li>
        <Link url={link.url} underline={false}>
          <Text variant="paragraph-s">{link.label}</Text>
        </Link>
      </li>
    ))
  }
  <FooterChangeLang slot="below" {alternates} />
</FooterColumn>
