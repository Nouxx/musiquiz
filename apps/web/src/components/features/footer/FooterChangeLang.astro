---
import Button from "@repo/ui/primitives/Button";

import { getLang } from "../../../libs/getLang";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";
import { getOtherLang } from "../../../libs/getOtherLang";

const currentLang = getLang(Astro);
const otherLang = getOtherLang(currentLang);

interface Props {
  venueSlug?: string;
}

const { venueSlug } = Astro.props;

const routes = getRoutesForLang(otherLang.lang);

// currently the lang switch button always redirect to home
// todo: make it redirect to the current page equivalent in /en
const route = venueSlug ? routes.venueHome(venueSlug) : routes.home;
---

<Button
  as="a"
  href={route}
  tone="light"
  size="s"
  icon={otherLang.icon}
  iconPosition="leading"
>
  {otherLang.label}
</Button>
