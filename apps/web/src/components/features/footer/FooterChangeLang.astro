---
import Button from "@repo/ui/primitives/Button";

import { getLang } from "../../../libs/getLang";
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";
import { getOtherLang } from "../../../libs/getOtherLang";

const currentLang = getLang(Astro);
const otherLang = getOtherLang(currentLang);

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;

const alternate = alternates[otherLang.lang];

// relative, or the preview worker would link to production
const route = alternate
  ? new URL(alternate).pathname
  : getRoutesForLang(otherLang.lang).home;
---

<Button
  as="a"
  href={route}
  tone="light"
  size="s"
  icon={otherLang.icon}
  iconPosition="leading"
>
  {otherLang.label}
</Button>
