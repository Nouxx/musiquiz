---
import type { VenueFooter } from "@repo/services/cms/types";
import Flex from "@repo/ui/primitives/Flex";
import RemoteImage from "@repo/ui/primitives/RemoteImage";
import Text from "@repo/ui/primitives/Text";

import { getLang } from "../../../libs/getLang";
import { getT } from "../../../libs/i18n";

interface Props {
  paymentMethods: VenueFooter["paymentMethods"];
}

const { paymentMethods } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);
---

<Flex gap="6" align="center" wrap="wrap">
  <Text variant="paragraph-s">{t("footer.paymentMethods")}</Text>
  <Flex gap="3" align="center" wrap="wrap">
    {
      paymentMethods.map((paymentMethod) => (
        <RemoteImage image={paymentMethod} variant="payment-icon" />
      ))
    }
  </Flex>
</Flex>
