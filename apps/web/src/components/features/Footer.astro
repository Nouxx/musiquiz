---
import Footer from "@repo/ui/Footer";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getFooterData } from "@repo/services/cms/getFooterData";
import { getLang } from "../../libs/getLang";
import FooterSection from "@repo/ui/footer/FooterSection";

import FooterBottom from "@repo/ui/footer/FooterBottom";
import Text from "@repo/ui/primitives/Text";
import FooterBottomLinks from "./footer/FooterBottomLinks.astro";
import FooterLogo from "./footer/FooterLogo.astro";
import FooterSocials from "./footer/FooterSocials.astro";
import FooterContact from "./footer/FooterContact.astro";
import FooterGames from "./footer/FooterGames.astro";
import FooterChooseVenue from "./footer/FooterChooseVenue.astro";
import Flex from "@repo/ui/primitives/Flex";
import FooterGeneralInformation from "./footer/FooterGeneralInformation.astro";
import FooterChangeLang from "./footer/FooterChangeLang.astro";

const lang = getLang(Astro);

const sanityConfig = getSanityConfigFromEnvironment();

const footerData = await getFooterData({
  lang,
  config: sanityConfig,
});

const {
  logo,
  socials,
  contact,
  gamesFormatsLinks,
  venuesLink, // todo: rename to venues
  paymentMethods,
} = footerData;
---

<div style={{ border: "1px solid black", margin: "2px" }}>
  <Footer>
    <FooterSection>
      <FooterLogo {logo} />
      <FooterSocials {socials} />
    </FooterSection>

    <FooterSection>
      <FooterContact {contact} />
      <FooterGames games={gamesFormatsLinks} />
      <FooterChooseVenue venues={venuesLink} />
      <Flex direction="column">
        <FooterGeneralInformation />
        <FooterChangeLang />
      </Flex>
    </FooterSection>

    <FooterBottom>
      <Text slot="left">© Musi'Quiz 2026</Text>
      <FooterBottomLinks slot="right" {paymentMethods} />
    </FooterBottom>
  </Footer>
</div>
