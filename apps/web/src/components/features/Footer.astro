---
import Footer from "@repo/ui/Footer";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getFooterData } from "@repo/services/cms/getFooterData";
import { getRoutesForLang } from "../../routing/routes";
import { getT } from "../../libs/i18n";
import { getLang } from "../../libs/getLang";

const lang = getLang(Astro);

const t = getT(lang);

const sanityConfig = getSanityConfigFromEnvironment();

const footerData = await getFooterData({
  lang,
  config: sanityConfig,
});

const { logo, socials, contact, gamesFormatsLinks, venuesLink, languageLink, paymentMethods } =
  footerData;

const routes = getRoutesForLang(lang);

const miscellaneousLinks = [
  { label: t("footer.faq"), url: routes.faq },
  { label: t("footer.contact"), url: routes.contact },
  // blog is not translated and only exists for FR
  ...(routes.blog ? [{ label: t("footer.blog"), url: routes.blog }] : []),
  { label: t("footer.press"), url: routes.press },
  { label: t("footer.franchise"), url: routes.franchise },
];

const bottomLinks = [
  { label: t("footer.termsAndConditions"), url: routes.termsAndConditions },
  { label: t("footer.gdpr"), url: routes.gdpr },
  { label: t("footer.legalsNotice"), url: routes.legalsNotice },
];
---

<div style={{ border: "1px solid black", margin: "2px" }}>
  <p>GlobalFooter</p>
  <Footer
    logo={logo}
    socials={socials}
    contact={contact}
    newsletter
    gamesLink={gamesFormatsLinks}
    languageLink={languageLink}
    venuesLink={venuesLink}
    miscellaneousLinks={miscellaneousLinks}
    bottomLinks={bottomLinks}
    bottomIcons={paymentMethods}
  />
</div>
