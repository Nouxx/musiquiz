---
import type { BlogArticleSummary } from "@repo/services/cms/types";
import BlogListingUi from "@repo/ui/BlogListing";

import { blogPageLinks, BLOG_PAGE_SIZE } from "../../libs/blogPagination";
import { getT } from "../../libs/i18n";
import { toArticleCard } from "../../libs/toArticleCard";

export interface Props {
  title: string;
  intro: string;
  articles: BlogArticleSummary[];
  page: number;
}

const { title, intro, articles, page } = Astro.props;

const t = getT("fr");

const featured = page === 1 ? articles.slice(0, 2).map(toArticleCard) : [];

const start = (page - 1) * BLOG_PAGE_SIZE;
const pageArticles = articles
  .slice(start, start + BLOG_PAGE_SIZE)
  .map(toArticleCard);

const pagination = {
  current: page,
  pages: blogPageLinks(articles.length).map((link) => ({
    ...link,
    label: t("blogPage.page", { page: link.page }),
  })),
  label: t("blogPage.pagination"),
  previousLabel: t("blogPage.previousPage"),
  nextLabel: t("blogPage.nextPage"),
};
---

<BlogListingUi
  badge={t("blogPage.badge")}
  {title}
  {intro}
  {featured}
  articles={pageArticles}
  {pagination}
/>
