---
import { getImage } from "astro:assets";
import type { BlogArticlePage } from "@repo/services/cms/types";
import type { BreadcrumbItem } from "@repo/ui/types";

import { getOrganizationId } from "../../libs/getOrganizationId";
import { getOrganizationLogoUrl } from "../../libs/getOrganizationLogoUrl";
import { getSite } from "../../libs/getSite";
import { toBreadcrumbList } from "../../libs/toBreadcrumbList";
import JsonLd from "./JsonLd.astro";

interface Props {
  data: BlogArticlePage;
  breadcrumbs: BreadcrumbItem[];
}

const { data, breadcrumbs } = Astro.props;

const site = getSite(Astro);

function plainText(spans: { text: string }[]) {
  return spans.map((span) => span.text).join("");
}

const cover = await getImage({
  src: data.cover.url,
  width: Math.min(data.cover.width, 1200),
  height: Math.round(
    (Math.min(data.cover.width, 1200) * data.cover.height) / data.cover.width,
  ),
  format: "jpeg",
});

const blogPosting = {
  "@type": "BlogPosting",
  headline: data.title,
  description: data.excerpt,
  image: new URL(cover.src, site).href,
  datePublished: data.publishedAt,
  dateModified: data.updatedAt ?? data.publishedAt,
  inLanguage: "fr",
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
  author: {
    "@type": "Person",
    name: data.author.name,
    jobTitle: data.author.jobTitle,
    url: data.author.profileUrl,
  },
  // in full: a bare @id does not reach the Organization node on the homepage
  publisher: {
    "@type": "Organization",
    "@id": getOrganizationId(site),
    name: "Musi'Quiz",
    url: site.href,
    logo: await getOrganizationLogoUrl(site, data.publisherLogo),
  },
};

const faqPage = data.faq && {
  "@type": "FAQPage",
  mainEntity: data.faq.questions.map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: entry.answer.map((node) => plainText(node.spans)).join("\n"),
    },
  })),
};
---

<JsonLd
  graph={[
    blogPosting,
    toBreadcrumbList(site, breadcrumbs),
    ...(faqPage ? [faqPage] : []),
  ]}
/>
