---
import { getImage } from "astro:assets";
import type { BlogArticlePage } from "@repo/services/cms/types";

import { getBlogId } from "../../libs/getBlogId";
import { getOrganizationId } from "../../libs/getOrganizationId";
import { getSite } from "../../libs/getSite";
import { getVenueBusinessId } from "../../libs/getVenueBusinessId";
import { getT } from "../../libs/i18n";
import { toBlog } from "../../libs/toBlog";
import { toFaqPage } from "../../libs/toFaqPage";
import JsonLd from "./JsonLd.astro";

interface Props {
  data: BlogArticlePage;
}

const { data } = Astro.props;

const site = getSite(Astro);
const url = new URL(Astro.url.pathname, site).href;

const cover = await getImage({
  src: data.cover.url,
  width: Math.min(data.cover.width, 1200),
  height: Math.round(
    (Math.min(data.cover.width, 1200) * data.cover.height) / data.cover.width,
  ),
  format: "jpeg",
});

const blogPosting = {
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  headline: data.title,
  description: data.excerpt,
  image: new URL(cover.src, site).href,
  datePublished: data.publishedAt,
  dateModified: data.updatedAt ?? data.publishedAt,
  inLanguage: "fr",
  timeRequired: `PT${data.readingMinutes}M`,
  mainEntityOfPage: url,
  isPartOf: { "@id": getBlogId(site) },
  ...(data.closesOn.kind === "venue" && {
    about: { "@id": getVenueBusinessId(site, data.closesOn.slug) },
  }),
  author: {
    "@type": "Person",
    name: data.author.name,
    jobTitle: data.author.jobTitle,
    ...(data.author.profileUrl && { sameAs: [data.author.profileUrl] }),
  },
  publisher: { "@id": getOrganizationId(site) },
};

// isPartOf must resolve on the page
const blog = toBlog({
  site,
  name: getT("fr")("footer.blog"),
  description: undefined,
});

const faqPage =
  data.faq && toFaqPage({ pageUrl: url, questions: data.faq.questions });
---

<JsonLd graph={[blogPosting, blog, ...(faqPage ? [faqPage] : [])]} />
