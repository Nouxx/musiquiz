---
import Header from "@repo/ui/Header";
import { getHeaderData } from "@repo/services/cms/getHeaderData";
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";
import { isCurrentUrl } from "@repo/services/routing/isCurrentUrl";
import { venuesMapAnchorId, type NavLink, type NavMenu } from "@repo/ui/types";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getT } from "../../libs/i18n";
import { getLang } from "../../libs/getLang";
import { getOtherLang } from "../../libs/getOtherLang";
import HeaderSocials from "./header/HeaderSocials.astro";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);

const data = await getHeaderData({
  config: getSanityConfigFromEnvironment(),
  lang,
});

const routes = getRoutesForLang(lang);

const otherLang = getOtherLang(lang);

const alternate = alternates[otherLang.lang];

const langSwitcher = {
  // relative, or the preview worker would link to production
  url: alternate
    ? new URL(alternate).pathname
    : getRoutesForLang(otherLang.lang).home,
  icon: otherLang.icon,
  label: otherLang.label,
};

const pathname = Astro.url.pathname;

// the collapse breakpoint ("header collapsed", breakpoints.css) was sized for
// VenueHeader's longer list; this one fits inside it
const mainLinks: (NavLink | NavMenu)[] = [
  {
    label: t("header.home"),
    url: routes.home,
  },
  data.experiences.length === 1
    ? {
        label: t("header.concept"),
        url: data.experiences[0].url,
      }
    : {
        label: t("header.experiences"),
        links: data.experiences,
      },
  {
    label: t("header.events"),
    links: data.events,
  },
];

function withCurrent(item: NavLink | NavMenu): NavLink | NavMenu {
  if (!("links" in item)) {
    return { ...item, current: isCurrentUrl(pathname, item.url) };
  }

  const links = item.links.map((link) => ({
    ...link,
    current: isCurrentUrl(pathname, link.url),
  }));

  return { ...item, links, current: links.some((link) => link.current) };
}

const linksTree = mainLinks.map(withCurrent);

// TODO: point to the global booking page once it exists
const cta = {
  label: t("header.book"),
  url: routes.home + `#${venuesMapAnchorId}`,
};

const contact = {
  phone: { label: data.contact.phoneLabel, url: data.contact.phoneHref },
  mail: { label: data.contact.mailLabel, url: data.contact.mailHref },
};
---

<Header
  logo={data.logo}
  mobileMenuLogo={data.mobileMenuLogo}
  {linksTree}
  {cta}
  lang={langSwitcher}
  closeLabel={t("header.closeLabel")}
  {contact}
>
  <HeaderSocials slot="socials" socials={data.socials} />
</Header>
