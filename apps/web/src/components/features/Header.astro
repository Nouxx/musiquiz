---
import Header from "@repo/ui/Header";
import { getHeaderData } from "@repo/services/cms/getHeaderData";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getRoutesForLang } from "../../routing/routes";
import type { Lang } from "@repo/utils/lang";

interface Props {
  venueSlug: string;
  lang: Lang;
}

const { lang, venueSlug } = Astro.props;

const sanityConfig = getSanityConfigFromEnvironment();

const data = await getHeaderData({ config: sanityConfig });

const routes = getRoutesForLang(lang);

const frenchMainLinks = [
  {
    label: "Accueil",
    url: routes.venueHome(venueSlug),
  },
  {
    label: "Nos expériences",
    links: data.experiences.map((experience) => ({
      label: experience.label,
      url: routes.venueGame(venueSlug, experience.slug),
    })),
  },
  {
    label: "Occasions (TODO)",
    url: "#todo",
  },
  {
    label: lang === "fr" ? "Offrir une partie" : "Offer a game",
    url: routes.venueGifting(venueSlug, lang),
  },
];

const englishMainLinks = [
  {
    label: "Home",
    url: routes.venueHome(venueSlug),
  },
];

const cta =
  lang === "fr"
    ? {
        label: "Réserver", // encoding issue
        url: routes.venueBook(venueSlug, "fr"),
      }
    : {
        label: "Book",
        url: routes.venueBook(venueSlug, "en"),
      };
---

<Header
  logo={data.logo}
  linksTree={lang === "fr" ? frenchMainLinks : englishMainLinks}
  cta={cta}
/>
