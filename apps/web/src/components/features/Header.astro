---
import Header from "@repo/ui/Header";
import { getHeaderData } from "@repo/services/cms/getHeaderData";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getT } from "../../libs/i18n";
import { getLang } from "../../libs/getLang";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";

interface Props {
  venueSlug: string;
}

const { venueSlug } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);

const sanityConfig = getSanityConfigFromEnvironment();

const data = await getHeaderData({ config: sanityConfig, lang, venueSlug });

const routes = getRoutesForLang(lang);

// WARNING: when modifying these links
// the viewport width at which the menu switch to "mobile burger menu"
// is hardcoded (search for "header collapsed" -- breakpoint.css) and depends on the number of items and their label
// if this has to be modified, adjust this value
const mainLinks = [
  {
    label: t("header.home"),
    url: routes.venueHome(venueSlug),
  },
  {
    label: "Concept", // todo: translate
    url: "#todo",
  },
  {
    label: t("header.experiences"),
    links: data.experiences,
  },
  {
    label: "Occasions", // todo: translate
    url: "#todo",
  },
  {
    label: t("header.offerAGame"),
    url: routes.venueGifting(venueSlug),
  },
];

const cta = {
  label: t("header.book"),
  url: routes.venueBook(venueSlug),
};
---

<Header logo={data.logo} venueLogo={data.venueLogo} linksTree={mainLinks} {cta} />
