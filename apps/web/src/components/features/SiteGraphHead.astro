---
import { getOrganizationData } from "@repo/services/cms/getOrganizationData";

import { getOrganizationId } from "../../libs/getOrganizationId";
import { getOrganizationLogoUrl } from "../../libs/getOrganizationLogoUrl";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getSite } from "../../libs/getSite";
import { getWebsiteId } from "../../libs/getWebsiteId";
import JsonLd from "./JsonLd.astro";

const site = getSite(Astro);
const organizationId = getOrganizationId(site);

const organization = await getOrganizationData({
  config: getSanityConfigFromEnvironment(),
});

const organizationData = {
  "@type": "Organization",
  "@id": organizationId,
  name: "Musi'Quiz",
  url: site.href,
  logo: await getOrganizationLogoUrl(site, organization.logo),
  sameAs: organization.sameAs,
  telephone: organization.telephone,
  email: organization.email,
};

const webSite = {
  "@type": "WebSite",
  "@id": getWebsiteId(site),
  name: "Musi'Quiz",
  url: site.href,
  inLanguage: ["fr", "en"],
  publisher: { "@id": organizationId },
};
---

<JsonLd graph={[organizationData, webSite]} />
