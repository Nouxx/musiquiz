---
interface Props {
  gtmIds: string[];
}

const { gtmIds } = Astro.props;
---

{
  gtmIds.map((id) => (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${id}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      />
    </noscript>
  ))
}
