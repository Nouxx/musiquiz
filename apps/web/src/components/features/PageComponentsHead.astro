---
import type { PageComponent } from "@repo/services/cms/pageComponent.types";

import { getSite } from "../../libs/getSite";
import { toFaqPage } from "../../libs/toFaqPage";
import JsonLd from "./JsonLd.astro";

interface Props {
  components: PageComponent[];
}

const { components } = Astro.props;

const hasReviews = components.some((component) => component.type === "reviews");

// one FAQPage per page, whatever the number of faq components
const questions = components.flatMap((component) =>
  component.type === "faq" ? component.questions : [],
);

const faqPage =
  questions.length > 0 &&
  toFaqPage({
    pageUrl: new URL(Astro.url.pathname, getSite(Astro)).href,
    questions,
  });
---

{
  hasReviews && (
    // no crossorigin: loader.js is fetched no-cors, a CORS preconnect would go unused
    <link rel="preconnect" href="https://cdn.trustindex.io" />
  )
}
{faqPage && <JsonLd graph={[faqPage]} />}
