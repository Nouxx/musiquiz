---
import type { Homepage } from "@repo/services/cms/types";
import VenuesMap from "@repo/ui/VenuesMap";
import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";

export interface Props {
  venues: Homepage["venues"];
  cta: Homepage["venuesCta"];
}

const { venues, cta } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);
---

<VenuesMap
  badge={t("venues.badge")}
  heading={t("venues.heading")}
  {venues}
  {cta}
/>
