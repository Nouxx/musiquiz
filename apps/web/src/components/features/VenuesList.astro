---
import type { Venue } from "@repo/services/cms/types";

interface Props {
  venues: Venue[];
}

const { venues } = Astro.props;
---

<div style={{ border: "1px solid black", margin: "2px" }}>
  <p>VenuesList</p>
  <ul>
    {
      venues.map((venue) => (
        <a href={venue.slug}>
          <li>{venue.title}</li>
        </a>
      ))
    }
  </ul>
</div>
