---
import type { CtaLink } from "@repo/ui/types";
import type { VenuePin } from "@repo/services/cms/types";
import VenuesMap from "@repo/ui/VenuesMap";
import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";

export interface Props {
  venues: VenuePin[];
  cta: CtaLink | undefined;
  badge?: string;
  heading?: string;
}

const lang = getLang(Astro);

const t = getT(lang);

const {
  venues,
  cta,
  badge = t("venues.badge"),
  heading = t("venues.heading"),
} = Astro.props;
---

<VenuesMap {badge} {heading} {venues} {cta} />
