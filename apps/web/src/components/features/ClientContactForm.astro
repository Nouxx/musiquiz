---
import ClientContactForm from "@repo/ui/ClientContactForm";
import type { ComponentProps } from "astro/types";

import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";

type Props = ComponentProps<typeof ClientContactForm> & {
  workerUrl: string;
  venueSlug: string;
};

const { workerUrl, venueSlug, ...rest } = Astro.props;

const t = getT(getLang(Astro));

const messages = {
  required: t("form.errors.required"),
  invalidMail: t("contactForm.errors.mail"),
};

// a `<` inside the copy would close the script element early
const serializedMessages = JSON.stringify(messages).replaceAll("<", "\\u003c");
---

<musiquiz-contact-form
  data-worker-url={`${workerUrl}/form/client-contact`}
  data-venue-slug={venueSlug}
>
  <ClientContactForm {...rest} />
  <script
    is:inline
    type="application/json"
    data-messages
    set:html={serializedMessages}
  />
</musiquiz-contact-form>

<style>
  musiquiz-contact-form {
    display: contents;
  }
</style>

<script>
  import "../../scripts/clientContactForm";
</script>
