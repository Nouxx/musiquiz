---
import PageCover from "@repo/ui/PageCover";
import RemoteImage from "@repo/ui/primitives/RemoteImage";
import type { CmsImage } from "@repo/services/cms/types";

interface Props {
  logo: CmsImage;
  cover: CmsImage;
  badgeLabel: string;
  heading: string;
}

const { logo, cover, badgeLabel, heading } = Astro.props;
---

<PageCover>
  <div style={{ border: "1px solid black", margin: "2px" }}>
    <p>HomepageCover</p>
    <RemoteImage image={cover} variant="cover" loading="eager" />
    <RemoteImage image={logo} variant="logo" loading="eager" />
    <p>badgeLabel: {badgeLabel}</p>
    <p>heading: {heading}</p>
  </div>
</PageCover>
