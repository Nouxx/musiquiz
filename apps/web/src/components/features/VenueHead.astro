---
import type { PageComponent } from "@repo/services/cms/pageComponent.types";
import type { LocalBusiness, Seo } from "@repo/services/cms/types";

import { getLang } from "../../libs/getLang";
import { getLogoUrl } from "../../libs/getLogoUrl";
import { getOgImage } from "../../libs/getOgImage";
import { getSite } from "../../libs/getSite";
import { toVenueBusiness } from "../../libs/toVenueBusiness";
import JsonLd from "./JsonLd.astro";

interface Props {
  venueSlug: string;
  /** @example "Paris" */
  city: string;
  business: LocalBusiness;
  seo: Seo;
  components: PageComponent[];
}

const { venueSlug, city, business, seo, components } = Astro.props;

const site = getSite(Astro);

const entertainmentBusiness = toVenueBusiness({
  site,
  lang: getLang(Astro),
  url: new URL(Astro.url.pathname, site).href,
  venueSlug,
  city,
  description: seo.description,
  imageUrl: (await getOgImage(site, seo.ogImage)).url,
  logoUrl: await getLogoUrl(site, business.logo),
  business,
  prices: components.find((component) => component.type === "venuePrices"),
});
---

<JsonLd graph={[entertainmentBusiness]} />
