---
import type { LocalBusiness } from "@repo/services/cms/types";
import { formatPrice } from "@repo/utils/formatPrice";

import { getLang } from "../../libs/getLang";
import { getOrganizationId } from "../../libs/getOrganizationId";
import { getSite } from "../../libs/getSite";
import { getVenueBusinessId } from "../../libs/getVenueBusinessId";
import JsonLd from "./JsonLd.astro";

interface Props {
  venueSlug: string;
  /** @example "Paris" */
  city: string;
  business: LocalBusiness;
}

const { venueSlug, city, business } = Astro.props;

const site = getSite(Astro);
const url = new URL(Astro.url.pathname, site).href;

function toPriceRange({
  lowest,
  highest,
  currency,
}: NonNullable<LocalBusiness["priceRange"]>) {
  const lang = getLang(Astro);
  const low = formatPrice({ amount: lowest, lang, currency });

  return lowest === highest
    ? low
    : `${low}–${formatPrice({ amount: highest, lang, currency })}`;
}

const priceRange = business.priceRange && toPriceRange(business.priceRange);

const entertainmentBusiness = {
  "@type": "EntertainmentBusiness",
  "@id": getVenueBusinessId(site, venueSlug),
  name: `Musi'Quiz ${city}`,
  url,
  address: { "@type": "PostalAddress", ...business.address },
  geo: { "@type": "GeoCoordinates", ...business.geo },
  telephone: business.telephone,
  email: business.email,
  hasMap: business.mapUrl,
  sameAs: business.sameAs,
  openingHoursSpecification: business.openingHours.map((hours) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: hours.days,
    opens: hours.opens,
    closes: hours.closes,
  })),
  priceRange,
  parentOrganization: { "@id": getOrganizationId(site) },
};
---

<JsonLd graph={[entertainmentBusiness]} />
