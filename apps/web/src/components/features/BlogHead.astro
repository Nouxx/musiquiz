---
import type { BlogPage } from "@repo/services/cms/types";

import { blogPageArticles, blogPageLinks } from "../../libs/blogPagination";
import { getSite } from "../../libs/getSite";
import { toBlog, toBlogItemList } from "../../libs/toBlog";
import JsonLd from "./JsonLd.astro";

export interface Props {
  data: BlogPage;
  page: number;
}

const { data, page } = Astro.props;

const site = getSite(Astro);

const pages = blogPageLinks(data.articles.length);
const previous = pages[page - 2]?.url;
const next = pages[page]?.url;

const articleUrls = blogPageArticles(data.articles, page).map(({ url }) => url);

const graph = [
  toBlog({ site, name: data.title, description: data.seo.description }),
  ...(articleUrls.length > 0
    ? [
        toBlogItemList({
          site,
          pageUrl: new URL(Astro.url.pathname, site).href,
          articleUrls,
        }),
      ]
    : []),
];
---

{previous && <link rel="prev" href={previous} />}
{next && <link rel="next" href={next} />}
<JsonLd {graph} />
