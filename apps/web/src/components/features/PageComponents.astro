---
import type { PageComponent } from "@repo/services/cms/pageComponent.types";
import CardsGrid from "@repo/ui/CardsGrid";
import CardsScroller from "@repo/ui/CardsScroller";
import DetailTabs from "@repo/ui/DetailTabs";
import TextSlideshow from "@repo/ui/TextSlideshow";
import TextStrip from "@repo/ui/TextStrip";
import TextBody from "@repo/ui/TextBody";
import TextCards from "@repo/ui/TextCards";
import TextCardsGrid from "@repo/ui/TextCardsGrid";
import VideoEmbed from "@repo/ui/VideoEmbed";
import Faq from "@repo/ui/Faq";
import Logos from "@repo/ui/Logos";
import FindUs from "@repo/ui/FindUs";
import ContactPanels from "@repo/ui/ContactPanels";
import Offers from "@repo/ui/Offers";
import Carousel from "@repo/ui/Carousel";
import RollingBanner from "@repo/ui/RollingBanner";
import { anchors } from "@repo/services/routing/anchors";
import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";
import Reviews from "@repo/ui/Reviews";
import Prices from "@repo/ui/Prices";
import { toPriceOffer } from "../../libs/toPriceOffer";
import { toContactFacts } from "../../libs/toContactFacts";
import { toContactPanels } from "../../libs/toContactPanels";
import { toOffers } from "../../libs/toOffers";
import { getVideoSources } from "../../libs/getVideoSources";
import ClientContactForm from "./ClientContactForm.astro";
import QuotationForm from "./QuotationForm.astro";
import { SANITY_STUDIO_WORKER_URL } from "astro:env/client";
import { CARTO_API_KEY } from "astro:env/client";

interface Props {
  components: PageComponent[];
}

const { components } = Astro.props;

const lang = getLang(Astro);

const t = getT(lang);
---

{
  components.map((component) => {
    switch (component.type) {
      case "rollingBanner": {
        return (
          <RollingBanner
            id={component.anchor}
            message={component.message}
            color={component.color}
          />
        );
      }
      case "cardsGrid": {
        return (
          <CardsGrid
            id={component.anchor}
            heading={component.heading}
            body={component.body}
            align={component.align}
            background={component.background}
            cta={component.cta}
            cards={component.cards}
          />
        );
      }
      case "carousel": {
        return (
          <Carousel
            id={component.anchor}
            badge={component.badge}
            title={component.title}
            body={component.body}
            cta={component.cta}
            ctaTone={component.ctaTone}
            slides={component.slides.map((slide) =>
              slide.kind === "image"
                ? slide
                : {
                    kind: "video",
                    sources: getVideoSources(slide.video, "carousel"),
                    poster: slide.poster,
                  },
            )}
            previousLabel={t("carousel.previous")}
            nextLabel={t("carousel.next")}
            goToSlideLabel={t("carousel.goToSlide")}
          />
        );
      }
      case "reviews": {
        return (
          <Reviews
            id={component.anchor}
            widgetId={component.widgetId}
            badge={component.badge}
            title={component.title}
            surface={component.surface}
          />
        );
      }
      case "venuePrices": {
        return (
          <Prices
            title={component.title}
            surface={component.surface}
            games={component.games.map((game) => toPriceOffer({ game, lang }))}
            bookCta={{
              label: t("prices.book"),
              ...component.bookingLink,
            }}
            cta={component.cta}
            footnote={component.footnote}
            id={anchors.prices}
          />
        );
      }
      case "findUs": {
        return (
          <FindUs
            id={component.anchor}
            media={component.media}
            badge={component.badge}
            title={component.title}
            facts={toContactFacts({ component, t })}
            cta={{
              label: t("findUs.viewOnGoogleMaps"),
              url: component.mapsUrl,
            }}
            map={{
              ...component.location,
              title: t("findUs.mapTitle", { venue: component.venueTitle }),
              apiKey: CARTO_API_KEY,
            }}
          />
        );
      }
      case "contactPanels": {
        const { media, offer, questions } = toContactPanels({ component, t });

        return (
          <ContactPanels id={component.anchor} {media} {offer} {questions} />
        );
      }
      case "faq": {
        return (
          <Faq
            id={component.anchor}
            badge={t("faq.badge")}
            title={component.title}
            questions={component.questions}
            images={component.images}
          />
        );
      }
      case "clientContactForm": {
        return (
          <ClientContactForm
            id={component.anchor}
            images={component.images}
            badge={t("contactForm.badge")}
            title={t("contactForm.title")}
            mediaLabel={t("contactForm.mediaLabel")}
            previousLabel={t("carousel.previous")}
            nextLabel={t("carousel.next")}
            goToSlideLabel={t("carousel.goToSlide")}
            firstNameLabel={t("contactForm.firstName")}
            firstNamePlaceholder={t("contactForm.firstNamePlaceholder")}
            mailLabel={t("contactForm.mail")}
            mailPlaceholder={t("contactForm.mailPlaceholder")}
            phoneLabel={t("contactForm.phone")}
            phonePlaceholder={t("contactForm.phonePlaceholder")}
            messageLabel={t("contactForm.message")}
            messagePlaceholder={t("contactForm.messagePlaceholder")}
            submitLabel={t("contactForm.submit")}
            workerUrl={SANITY_STUDIO_WORKER_URL}
            venueSlug={component.venueSlug}
          />
        );
      }
      case "quotationForm": {
        const audience = component.audience;
        const copy = `quotationForm.${audience}` as const;

        return (
          <QuotationForm
            id={component.anchor}
            badge={t(`${copy}.badge`)}
            title={t(`${copy}.title`)}
            lastNameLabel={t(`${copy}.lastName`)}
            lastNamePlaceholder={t(`${copy}.lastNamePlaceholder`)}
            firstNameLabel={t(`${copy}.firstName`)}
            firstNamePlaceholder={t(`${copy}.firstNamePlaceholder`)}
            phoneLabel={t(`${copy}.phone`)}
            phonePlaceholder={t(`${copy}.phonePlaceholder`)}
            mailLabel={t(`${copy}.mail`)}
            mailPlaceholder={t(`${copy}.mailPlaceholder`)}
            displayCompany={audience === "teamBuilding"}
            companyLabel={t(`${copy}.company`)}
            companyPlaceholder={t(`${copy}.companyPlaceholder`)}
            dateLabel={t(`${copy}.date`)}
            timeLabel={t(`${copy}.time`)}
            participantsLabel={t(`${copy}.participants`)}
            participantsPlaceholder={t(`${copy}.participantsPlaceholder`)}
            displayBudget={audience === "teamBuilding"}
            budgetLabel={t(`${copy}.budget`)}
            budgetPlaceholder={t(`${copy}.budgetPlaceholder`)}
            servicesLabel={t(`${copy}.services`)}
            services={component.services}
            messageLabel={t(`${copy}.message`)}
            messagePlaceholder={t(`${copy}.messagePlaceholder`)}
            submitLabel={t(`${copy}.submit`)}
            workerUrl={SANITY_STUDIO_WORKER_URL}
            venueSlug={component.venueSlug}
            audience={component.audience}
          />
        );
      }
      case "logos": {
        return (
          <Logos
            id={component.anchor}
            layout={component.layout}
            surface={component.surface}
            badge={component.badge}
            title={component.title}
            logos={component.logos}
          />
        );
      }
      case "cardsScroller": {
        return (
          <CardsScroller
            id={component.anchor}
            badge={component.textBlock.badge}
            title={component.textBlock.title}
            body={component.textBlock.body}
            additionalCtas={component.textBlock.additionalCtas}
            cta={component.textBlock.cta}
            ctaTone={component.textBlock.ctaTone}
            cards={component.cards}
            nextCardLabel={t("cardsScroller.nextCard")}
          />
        );
      }
      case "textSlideshow": {
        return (
          <TextSlideshow
            id={component.anchor}
            badge={component.textBlock.badge}
            title={component.textBlock.title}
            body={component.textBlock.body}
            additionalCtas={component.textBlock.additionalCtas}
            cta={component.textBlock.cta}
            ctaTone={component.textBlock.ctaTone}
            surface={component.surface}
            slideshowPosition={component.slideshowPosition}
            images={component.images}
            previousLabel={t("carousel.previous")}
            nextLabel={t("carousel.next")}
            goToSlideLabel={t("carousel.goToSlide")}
          />
        );
      }
      case "textStrip": {
        return (
          <TextStrip
            id={component.anchor}
            badge={component.textBlock.badge}
            title={component.textBlock.title}
            body={component.textBlock.body}
            additionalCtas={component.textBlock.additionalCtas}
            cta={component.textBlock.cta}
            ctaTone={component.textBlock.ctaTone}
            images={component.images}
          />
        );
      }
      case "textBody": {
        return <TextBody id={component.anchor} body={component.body} />;
      }
      case "textCards": {
        return (
          <TextCards
            id={component.anchor}
            badge={component.textBlock.badge}
            title={component.textBlock.title}
            body={component.textBlock.body}
            additionalCtas={component.textBlock.additionalCtas}
            cta={component.textBlock.cta}
            ctaTone={component.textBlock.ctaTone}
            cards={component.cards}
          />
        );
      }
      case "textCardsGrid": {
        return (
          <TextCardsGrid
            id={component.anchor}
            heading={component.heading}
            body={component.body}
            cta={component.cta}
            cards={component.cards}
          />
        );
      }
      case "offers": {
        return (
          <Offers id={component.anchor} {...toOffers({ component, t, lang })} />
        );
      }
      case "videoEmbed": {
        return (
          <VideoEmbed
            id={component.anchor}
            videoId={component.videoId}
            title={component.title}
            surface={component.surface}
          />
        );
      }
      case "detailTabs": {
        return (
          <DetailTabs
            id={component.anchor}
            title={component.title}
            groups={component.groups}
            images={component.images}
            chooseGroupLabel={t("detailTabs.chooseGroup")}
          />
        );
      }
      case "gamePrices": {
        return (
          <Prices
            title={component.title}
            surface={component.surface}
            games={[toPriceOffer({ game: component.game, lang })]}
            bookCta={{
              label: t("prices.book"),
              ...component.bookingLink,
            }}
            cta={component.cta}
            footnote={component.footnote}
            id={anchors.prices}
          />
        );
      }
    }
  })
}
