---
import { teamBuildingQuotationFormLimits } from "@repo/services/contactForm/teamBuildingQuotation";
import TeamBuildingQuotationForm from "@repo/ui/TeamBuildingQuotationForm";
import type { ComponentProps } from "astro/types";

import { getLang } from "../../libs/getLang";
import { getT } from "../../libs/i18n";

type Props = Omit<
  ComponentProps<typeof TeamBuildingQuotationForm>,
  | "pendingLabel"
  | "successMessage"
  | "failureMessage"
  | "lastNameMaxLength"
  | "firstNameMaxLength"
  | "phoneMaxLength"
  | "mailMaxLength"
  | "companyMaxLength"
  | "participantsMaxLength"
  | "budgetMaxLength"
  | "messageMaxLength"
> & {
  workerUrl: string;
  venueSlug: string;
};

const { workerUrl, venueSlug, ...rest } = Astro.props;

const t = getT(getLang(Astro));

const messages = {
  required: t("form.errors.required"),
  invalidMail: t("form.errors.mail"),
  // the numbers change per keystroke, so the script does the substitution;
  // `used` rather than `count`, which i18next reads as a plural selector
  counter: t("form.counter", { used: "__USED__", max: "__MAX__" }),
};

// a `<` inside the copy would close the script element early
const serializedMessages = JSON.stringify(messages).replaceAll("<", "\\u003c");
---

<musiquiz-quotation-form
  data-worker-url={`${workerUrl}/form/team-building-quotation`}
  data-venue-slug={venueSlug}
>
  <TeamBuildingQuotationForm
    {...rest}
    pendingLabel={t("teamBuildingQuotationForm.pending")}
    successMessage={t("teamBuildingQuotationForm.success")}
    failureMessage={t("teamBuildingQuotationForm.failure")}
    lastNameMaxLength={teamBuildingQuotationFormLimits.lastName}
    firstNameMaxLength={teamBuildingQuotationFormLimits.firstName}
    phoneMaxLength={teamBuildingQuotationFormLimits.phone}
    mailMaxLength={teamBuildingQuotationFormLimits.mail}
    companyMaxLength={teamBuildingQuotationFormLimits.company}
    participantsMaxLength={teamBuildingQuotationFormLimits.participants}
    budgetMaxLength={teamBuildingQuotationFormLimits.budget}
    messageMaxLength={teamBuildingQuotationFormLimits.message}
  />
  <script
    is:inline
    type="application/json"
    data-messages
    set:html={serializedMessages}
  />
</musiquiz-quotation-form>

<style>
  musiquiz-quotation-form {
    display: contents;
  }
</style>

<script>
  import "../../scripts/teamBuildingQuotationForm";
</script>
