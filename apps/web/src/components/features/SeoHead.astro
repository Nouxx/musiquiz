---
import type { CmsImage } from "@repo/services/cms/types";
import type { Alternates } from "@repo/services/routing/getAlternatesUrl";
import type { BreadcrumbItem } from "@repo/ui/types";

import { getLang } from "../../libs/getLang";
import { getOgImage } from "../../libs/getOgImage";
import { getSite } from "../../libs/getSite";
import { toBreadcrumbList } from "../../libs/toBreadcrumbList";
import { toWebPage, type WebPageType } from "../../libs/toWebPage";
import JsonLd from "./JsonLd.astro";

export interface Props {
  /** @example "Pixel Games", rendered "Pixel Games · Musi'Quiz Paris" */
  title?: string;
  /** @example "Paris" */
  city?: string;
  description?: string;
  alternates: Alternates | undefined;
  ogImage?: CmsImage;
  noindex?: boolean;
  updatedAt?: string;
  breadcrumbs?: BreadcrumbItem[];
  webPageType?: WebPageType;
  venueSlug?: string;
}

const {
  title,
  city,
  description,
  alternates,
  ogImage,
  noindex = false,
  updatedAt,
  breadcrumbs,
  webPageType = "WebPage",
  venueSlug,
} = Astro.props;

const site = getSite(Astro);
const lang = getLang(Astro);

const canonical = alternates ? alternates[lang] : undefined;

if (alternates && !canonical) {
  throw new Error(`${Astro.url.pathname} has no ${lang} alternate`);
}

const brand = "Musi'Quiz";
const brandWithCity = city ? `${brand} ${city}` : brand;
const fullTitle = title ? `${title} · ${brandWithCity}` : brandWithCity;

const ogLocales = { fr: "fr_FR", en: "en_GB" } as const;
const otherLang = lang === "fr" ? "en" : "fr";

const og = ogImage && (await getOgImage(site, ogImage));

const graph = canonical
  ? [
      toWebPage({
        site,
        type: webPageType,
        url: canonical,
        name: fullTitle,
        description,
        lang,
        venueSlug,
        image: og,
        hasBreadcrumb: breadcrumbs !== undefined,
        updatedAt,
      }),
      ...(breadcrumbs
        ? [toBreadcrumbList({ site, pageUrl: canonical, items: breadcrumbs })]
        : []),
    ]
  : [];
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, follow" />}

{canonical && <link rel="canonical" href={canonical} />}
{
  alternates?.en && (
    <>
      <link rel="alternate" hreflang="fr" href={alternates.fr} />
      <link rel="alternate" hreflang="en" href={alternates.en} />
      <link rel="alternate" hreflang="x-default" href={alternates.fr} />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={brand} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={ogLocales[lang]} />
{
  alternates?.[otherLang] && (
    <meta property="og:locale:alternate" content={ogLocales[otherLang]} />
  )
}
{
  og && (
    <>
      <meta property="og:image" content={og.url} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content={String(og.width)} />
      <meta property="og:image:height" content={String(og.height)} />
      {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    </>
  )
}
{/* X reads title, description and image from the og: tags */}
<meta name="twitter:card" content={og ? "summary_large_image" : "summary"} />

{graph.length > 0 && <JsonLd {graph} />}
