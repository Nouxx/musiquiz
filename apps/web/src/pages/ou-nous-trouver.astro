---
import { getWhereToFindUsPageData } from "@repo/services/cms/getWhereToFindUsPageData";
import { getAlternatesUrl } from "@repo/services/routing/getAlternatesUrl";

import PageComponentsHead from "../components/features/PageComponentsHead.astro";
import WhereToFindUsPage from "../components/pages/WhereToFindUsPage.astro";
import Layout from "../layouts/Layout.astro";
import { getLang } from "../libs/getLang";
import { getSanityConfigFromEnvironment } from "../libs/getSanityConfigFromEnvironment";
import { getSite } from "../libs/getSite";

const data = await getWhereToFindUsPageData({
  lang: getLang(Astro),
  config: getSanityConfigFromEnvironment(),
});

const alternates = getAlternatesUrl(
  getSite(Astro),
  (routes) => routes.whereToFindUs,
);
---

<Layout {...data.seo} {alternates} webPageType="CollectionPage">
  <PageComponentsHead
    slot="head"
    components={[...data.componentsBeforeMap, ...data.componentsAfterMap]}
  />
  <WhereToFindUsPage {data} {alternates} />
</Layout>
