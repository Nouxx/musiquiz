---
import VenueHomepage from "../../components/pages/VenueHomepage.astro";
import VenueLayout from "../../layouts/VenueLayout.astro";
import { getVenuesSlugParameters } from "../../routing/getVenuesSlugParameters";

export async function getStaticPaths() {
  const params = await getVenuesSlugParameters();
  return params;
}

const { venue } = Astro.params;
---

<VenueLayout lang="fr" venueSlug={venue}>
  <VenueHomepage lang="fr" venueSlug={venue} />
</VenueLayout>
