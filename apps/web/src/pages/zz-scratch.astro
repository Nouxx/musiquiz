---
// THROWAWAY QA route — delete before merging.
import Layout from "../layouts/Layout.astro";
import RollingBanner from "@repo/ui/RollingBanner";
import Section from "@repo/ui/Section";

// the real homepage message
const realMessage = "Il fait chaud ! Toutes nos salles sont climatisées";

// the case the build-time width estimate is most likely to get wrong: short
// enough that a wide viewport needs many copies to stay filled
const shortMessage = "Soldes !";

const longMessage =
  "Il fait chaud ! Toutes nos salles sont climatisées, et nos équipes vous accueillent sept jours sur sept pour un quiz musical entre amis";
---

<Layout>
  <!-- 1. THE REAL CASE — the homepage message, full bleed, flush against
       whatever sits above and below it. Watch for: a seamless loop (no jump
       when the track restarts), and no page-level horizontal scrollbar. -->
  <Section spacing="m">
    <p class="hint">Above the banner — the strip should sit flush, no margin</p>
  </Section>

  <RollingBanner message={realMessage} />

  <Section spacing="m">
    <p class="hint">Below the banner</p>
  </Section>

  <!-- 2. SHORT MESSAGE — the fill estimator's hard case. Widen the viewport as
       far as it goes: a gap must never open between copies. -->
  <RollingBanner message={shortMessage} />

  <Section spacing="m">
    <p class="hint">
      Short message above — 8 characters. Any hole in the strip at any width is
      the estimator under-provisioning.
    </p>
  </Section>

  <!-- 3. LONG MESSAGE — the other end. Speed should read the same as case 1
       despite the message being ~3x longer; that is the point of deriving the
       duration from the estimated width. -->
  <RollingBanner message={longMessage} />

  <Section spacing="m">
    <p class="hint">
      Long message above — compare its speed against the first banner. They
      should look identical, both ~90px/s.
    </p>
  </Section>

  <!-- 4. NARROW — shrink to 375px. Text steps down 24px -> 20px on the h5
       clamp, the 80px gap stays put, the strip keeps its 24px block padding. -->
  <RollingBanner message={realMessage} />

  <Section spacing="m">
    <p class="hint">
      Drag to 375px: type clamps to 20px, gap stays 80px, height ~70px.
    </p>
    <p class="hint">
      Then turn on Reduce Motion (System Settings &gt; Accessibility &gt;
      Display): every banner should stop dead and stay legible, not blank and
      not mid-jump.
    </p>
  </Section>
</Layout>

<style>
  .hint {
    font: var(--paragraph-s);
    color: var(--color-text-muted);
  }

  .hint + .hint {
    margin-block-start: var(--space-4);
  }
</style>
