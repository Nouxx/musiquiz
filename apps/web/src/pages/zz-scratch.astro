---
// THROWAWAY QA route — delete before merging.
import Layout from "../layouts/Layout.astro";
import Button from "@repo/ui/primitives/Button";
import MenuButton from "@repo/ui/primitives/MenuButton";

const tones = ["red", "blue", "green", "light"] as const;
const sizes = ["l", "m", "s"] as const;

// the real homepage CTA — the longest label the app actually ships
const longLabel = "Choisir votre centre Musi'Quiz";
---

<Layout>
  <!-- 1. NAV BAR — MenuButton in its real home: a row on a dark surface.
       Shrink the viewport to watch the clamp run 34px -> 48px. -->
  <nav class="bar">
    <MenuButton href="/">Accueil</MenuButton>
    <MenuButton href="/" current>Page courante</MenuButton>
    <details>
      <MenuButton as="summary" icon="angle-down">Nos centres</MenuButton>
      <a href="/" class="drop">Un lien</a>
    </details>
    <MenuButton as="button" icon="angle-down">Bouton</MenuButton>
  </nav>

  <!-- 2. PAGE COVER CTA — the PageCover case: one centred button in a padded
       column. This is where a too-long label overflows now that it cannot
       wrap; narrow the viewport past ~380px to see it. -->
  <section class="cover">
    <p class="hint">Centred CTA, container padding 1.5rem</p>
    <Button icon="angle-down">{longLabel}</Button>
  </section>

  <!-- 3. ACTION ROW — two buttons side by side, the common real pairing.
       Wraps to a column rather than squeezing. -->
  <section class="panel">
    <p class="hint">Action row, wraps</p>
    <div class="actions">
      <Button icon="arrow-right">Continuer</Button>
      <Button tone="light">Annuler</Button>
    </div>
  </section>

  <!-- 4. REFERENCE MATRIX — not a real layout. Every tone x size, wrapping so
       the grid never lies about the buttons' size. -->
  <section class="panel">
    <p class="hint">Reference matrix — every tone x size</p>
    {
      tones.map((tone) => (
        <div class="row">
          {sizes.map((size) => (
            <Button tone={tone} size={size} icon="arrow-right">
              Bouton {size}
            </Button>
          ))}
          <Button tone={tone}>Sans icone</Button>
          <Button tone={tone} icon="pin" iconPosition="leading">
            Leading
          </Button>
          <Button as="a" href="/" tone={tone} size="m" icon="arrow-right">
            Lien
          </Button>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-surface-inverse);
  }

  .drop {
    display: block;
    padding: var(--space-2) var(--space-6);
    color: var(--color-text-on-media);
  }

  .cover {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-12) var(--space-6);
  }

  .panel {
    padding: var(--space-8) var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .actions,
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .row + .row {
    margin-block-start: var(--space-4);
  }

  .hint {
    margin-block-end: var(--space-4);
    font: var(--paragraph-s);
    color: var(--color-text-muted);
  }
</style>
