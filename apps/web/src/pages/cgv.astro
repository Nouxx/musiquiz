---
import { getTermsAndConditionsPageData } from "@repo/services/cms/getTermsAndConditionsPageData";
import { getAlternatesUrl } from "@repo/services/routing/getAlternatesUrl";

import TermsAndConditionsPage from "../components/pages/TermsAndConditionsPage.astro";
import Layout from "../layouts/Layout.astro";
import { getLang } from "../libs/getLang";
import { getSanityConfigFromEnvironment } from "../libs/getSanityConfigFromEnvironment";
import { getSite } from "../libs/getSite";

const data = await getTermsAndConditionsPageData({
  lang: getLang(Astro),
  config: getSanityConfigFromEnvironment(),
});

const alternates = getAlternatesUrl(
  getSite(Astro),
  (routes) => routes.termsAndConditions,
);
---

<Layout
  title={data.pageCover.heading}
  description={data.pageCover.subHeading}
  {alternates}
>
  <TermsAndConditionsPage {data} {alternates} />
</Layout>
