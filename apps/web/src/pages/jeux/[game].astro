---
import { getGlobalGamePageData } from "@repo/services/cms/getGlobalGamePageData";
import { getAlternatesUrl } from "@repo/services/routing/getAlternatesUrl";

import BreadcrumbHead from "../../components/features/BreadcrumbHead.astro";
import GlobalGamePage from "../../components/pages/GlobalGamePage.astro";
import Layout from "../../layouts/Layout.astro";
import { getGlobalBreadcrumbs } from "../../libs/getGlobalBreadcrumbs";
import { getGlobalGamesSlugParameters } from "../../libs/getGlobalGamesSlugParameters";
import { getLang } from "../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getSite } from "../../libs/getSite";

export async function getStaticPaths() {
  return getGlobalGamesSlugParameters();
}

const { game } = Astro.params;

const lang = getLang(Astro);

const data = await getGlobalGamePageData({
  lang,
  gameSlug: game,
  config: getSanityConfigFromEnvironment(),
});

const alternates = getAlternatesUrl(getSite(Astro), (routes) =>
  routes.game(game),
);

const breadcrumbs = getGlobalBreadcrumbs(lang, data.gameName);
---

<Layout {...data.seo} {alternates}>
  <BreadcrumbHead slot="head" items={breadcrumbs} />
  <GlobalGamePage {data} {alternates} />
</Layout>
