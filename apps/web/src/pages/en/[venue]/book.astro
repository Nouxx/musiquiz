---
import { getVenueWidgetPageData } from "@repo/services/cms/getVenueWidgetPageData";
import { getAlternatesUrl } from "@repo/services/routing/getAlternatesUrl";

import PageComponentsHead from "../../../components/features/PageComponentsHead.astro";
import VenueBookingPage from "../../../components/pages/VenueBookingPage.astro";
import VenueLayout from "../../../layouts/VenueLayout.astro";
import { getLang } from "../../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../../libs/getSanityConfigFromEnvironment";
import { getSite } from "../../../libs/getSite";
import { getVenueBreadcrumbs } from "../../../libs/getVenueBreadcrumbs";
import { getWidgetVenuesSlugParameters } from "../../../libs/getWidgetVenuesSlugParameters";
import { getT } from "../../../libs/i18n";

export async function getStaticPaths() {
  const params = await getWidgetVenuesSlugParameters("book");
  return params;
}

const { venue } = Astro.params;

const lang = getLang(Astro);

const data = await getVenueWidgetPageData({
  lang,
  venueSlug: venue,
  pageType: "book",
  config: getSanityConfigFromEnvironment(),
});

const alternates = getAlternatesUrl(getSite(Astro), (routes) =>
  routes.venueBook(venue),
);

const breadcrumbs = getVenueBreadcrumbs(
  lang,
  { slug: venue, title: data.venueTitle },
  getT(lang)("header.book"),
);
---

<VenueLayout
  venueSlug={venue}
  pageType="book"
  hidePopup
  city={data.venueTitle}
  {...data.seo}
  {breadcrumbs}
  {alternates}
>
  <PageComponentsHead
    slot="head"
    components={[...data.componentsBeforeWidget, ...data.componentsAfterWidget]}
  />
  <VenueBookingPage venueSlug={venue} {data} {alternates} />
</VenueLayout>
