---
import { getVenueGamePageData } from "@repo/services/cms/getVenueGamePageData";
import { getAlternatesUrl } from "@repo/services/routing/getAlternatesUrl";

import PageComponentsHead from "../../../../components/features/PageComponentsHead.astro";
import VenueGameHead from "../../../../components/features/VenueGameHead.astro";
import VenueGamePage from "../../../../components/pages/VenueGamePage.astro";
import VenueLayout from "../../../../layouts/VenueLayout.astro";
import { getLang } from "../../../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../../../libs/getSanityConfigFromEnvironment";
import { getSite } from "../../../../libs/getSite";
import { getVenueBreadcrumbs } from "../../../../libs/getVenueBreadcrumbs";
import { getVenueGamesSlugParameters } from "../../../../libs/getVenueGamesSlugParameters";

export async function getStaticPaths() {
  const params = await getVenueGamesSlugParameters();
  return params;
}

const { venue, game } = Astro.params;

const lang = getLang(Astro);

const data = await getVenueGamePageData({
  lang,
  venueSlug: venue,
  gameSlug: game,
  config: getSanityConfigFromEnvironment(),
});

const alternates = getAlternatesUrl(getSite(Astro), (routes) =>
  routes.venueGame(venue, game),
);

const breadcrumbs = getVenueBreadcrumbs(
  lang,
  { slug: venue, title: data.venueTitle },
  data.gameName,
);
---

<VenueLayout
  venueSlug={venue}
  city={data.venueTitle}
  {...data.seo}
  {breadcrumbs}
  {alternates}
>
  <VenueGameHead slot="head" venueSlug={venue} gameSlug={game} {data} />
  <PageComponentsHead slot="head" components={data.components} />
  <VenueGamePage venueSlug={venue} {data} {alternates} />
</VenueLayout>
