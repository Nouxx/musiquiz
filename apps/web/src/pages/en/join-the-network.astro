---
import { getJoinTheNetworkPageData } from "@repo/services/cms/getJoinTheNetworkPageData";
import { getAlternatesUrl } from "@repo/services/routing/getAlternatesUrl";

import JoinTheNetworkPage from "../../components/pages/JoinTheNetworkPage.astro";
import Layout from "../../layouts/Layout.astro";
import { getLang } from "../../libs/getLang";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getSite } from "../../libs/getSite";

const data = await getJoinTheNetworkPageData({
  lang: getLang(Astro),
  config: getSanityConfigFromEnvironment(),
});

const alternates = getAlternatesUrl(
  getSite(Astro),
  (routes) => routes.joinTheNetwork,
);
---

<Layout
  title={data.pageCover.heading}
  description={data.pageCover.subHeading}
  {alternates}
>
  <JoinTheNetworkPage {data} {alternates} />
</Layout>
