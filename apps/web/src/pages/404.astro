---
import { Picture } from "astro:assets";
import { getHeaderData } from "@repo/services/cms/getHeaderData";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";
import PageCover from "@repo/ui/PageCover";
import Button from "@repo/ui/primitives/Button";
import RemoteImage from "@repo/ui/primitives/RemoteImage";
import Text from "@repo/ui/primitives/Text";

import cover from "../assets/not-found-cover.jpg";
import Layout from "../layouts/Layout.astro";
import { getSanityConfigFromEnvironment } from "../libs/getSanityConfigFromEnvironment";
import { getT } from "../libs/i18n";

// one page for both languages: Cloudflare serves the nearest file named
// 404.html, and Astro only names the root one that way (en/404.astro would
// become en/404/index.html)
const fr = getT("fr");
const en = getT("en");

const { logo } = await getHeaderData({
  config: getSanityConfigFromEnvironment(),
  lang: "fr",
});
---

<Layout title={fr("notFound.title")} alternates={undefined}>
  <main>
    <PageCover>
      <Picture
        slot="media"
        src={cover}
        alt=""
        widths={[640, 1024, 1536, 2048]}
        sizes="100vw"
        formats={["avif", "webp"]}
        priority
      />

      <RemoteImage
        slot="logo"
        image={logo}
        variant="cover-logo"
        loading="eager"
      />

      <Text slot="heading" as="h1" variant="title-h1">
        {fr("notFound.heading")}
      </Text>

      <Text slot="subheading" variant="paragraph-base">
        <span lang="en">{en("notFound.heading")}</span>
      </Text>

      <Button slot="actions" as="a" href={getRoutesForLang("fr").home}>
        {fr("notFound.home")} · <span lang="en">{en("notFound.home")}</span>
      </Button>
    </PageCover>
  </main>
</Layout>
