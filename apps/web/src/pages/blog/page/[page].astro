---
import { getBlogPageData } from "@repo/services/cms/getBlogPageData";

import BlogHead from "../../../components/features/BlogHead.astro";
import BlogPage from "../../../components/pages/BlogPage.astro";
import Layout from "../../../layouts/Layout.astro";
import { getBlogPageParameters } from "../../../libs/getBlogPageParameters";
import { getSanityConfigFromEnvironment } from "../../../libs/getSanityConfigFromEnvironment";
import { getT } from "../../../libs/i18n";

export async function getStaticPaths() {
  return getBlogPageParameters();
}

const page = Number(Astro.params.page);

const data = await getBlogPageData({
  config: getSanityConfigFromEnvironment(),
});

const title = getT("fr")("blogPage.pageTitle", { title: data.title, page });
---

<Layout {title} description={data.intro}>
  <BlogHead slot="head" articleCount={data.articles.length} {page} />
  <BlogPage {data} {page} />
</Layout>
