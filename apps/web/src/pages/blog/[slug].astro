---
import { getBlogArticlePageData } from "@repo/services/cms/getBlogArticlePageData";
import { getVenueReviews } from "@repo/services/reviews/getVenueReviews";
import { getRoutesForLang } from "@repo/services/routing/getRoutesForLang";
import type { BreadcrumbItem } from "@repo/ui/types";

import BlogArticleHead from "../../components/features/BlogArticleHead.astro";
import BlogArticlePage from "../../components/pages/BlogArticlePage.astro";
import Layout from "../../layouts/Layout.astro";
import { getBlogArticleParameters } from "../../libs/getBlogArticleParameters";
import { getSanityConfigFromEnvironment } from "../../libs/getSanityConfigFromEnvironment";
import { getSite } from "../../libs/getSite";
import { getT } from "../../libs/i18n";
import { GOOGLE_PLACES_API_KEY } from "astro:env/server";

export async function getStaticPaths() {
  return getBlogArticleParameters();
}

const { slug } = Astro.params;

// we could have made a <BlogArticlePage> component handle the fetch
// but since there is no `/en`, it's not a big deal.
const data = await getBlogArticlePageData({
  config: getSanityConfigFromEnvironment(),
  slug,
});

const reviews =
  data.closesOn.kind === "venue"
    ? await getVenueReviews({
        venueGooglePlaceId: data.closesOn.googlePlaceId,
        googleApiKey: GOOGLE_PLACES_API_KEY,
      })
    : undefined;

const routes = getRoutesForLang("fr");

const alternates = {
  fr: new URL(routes.blogArticle(slug), getSite(Astro)).href,
};

function toTopicCrumbs(closesOn: typeof data.closesOn): BreadcrumbItem[] {
  if (closesOn.kind === "venue") {
    return [{ label: closesOn.title, url: routes.venueHome(closesOn.slug) }];
  }
  if (closesOn.kind === "event") {
    return [{ label: closesOn.title, url: routes.event(closesOn.slug) }];
  }
  return [];
}

const breadcrumbs: BreadcrumbItem[] = [
  { label: getT("fr")("footer.blog"), url: routes.blog },
  ...toTopicCrumbs(data.closesOn),
  { label: data.title },
];
---

<Layout {...data.seo} {breadcrumbs} {alternates}>
  <BlogArticleHead slot="head" {data} />
  <BlogArticlePage {data} {reviews} {breadcrumbs} {alternates} />
</Layout>
