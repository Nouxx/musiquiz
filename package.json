{
  "name": "musiquiz",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "clean": "pnpm --recursive --parallel clean",
    "build": "pnpm --recursive --parallel build",
    "build:web:static": "pnpm --filter web build:static",
    "build:web:ssr": "pnpm --filter web build:ssr",
    "deploy:web:static": "pnpm --filter web run deploy:static",
    "deploy:web:ssr": "pnpm --filter web run deploy:ssr",
    "deploy:sanity": "pnpm --filter sanity run deploy",
    "format:check": "prettier . --check",
    "fc": "pnpm format:check",
    "format:fix": "prettier . --write",
    "ff": "pnpm format:fix",
    "lint": "pnpm --recursive lint",
    "tsc": "pnpm --recursive tsc",
    "typegen": "pnpm --filter sanity typegen"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1"
  }
}
