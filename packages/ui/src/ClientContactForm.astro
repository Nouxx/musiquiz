---
import Badge from "./Badge.astro";
import Button from "./primitives/Button.astro";
import MiniCarousel from "./primitives/MiniCarousel.astro";
import Text from "./primitives/Text.astro";
import TextField from "./primitives/TextField.astro";
import TwoBlocks from "./primitives/TwoBlocks.astro";
import Section from "./Section.astro";
import type { ImageSource } from "./types";

interface Props {
  badge: string;
  title: string;
  images: ImageSource[];
  mediaLabel: string;
  previousLabel: string;
  nextLabel: string;
  goToImageLabel: string;
  firstNameLabel: string;
  firstNamePlaceholder: string;
  mailLabel: string;
  mailPlaceholder: string;
  phoneLabel: string;
  phonePlaceholder: string;
  messageLabel: string;
  messagePlaceholder: string;
  submitLabel: string;
  workerUrl: string;
  venueSlug: string;
}

const {
  badge,
  title,
  images,
  mediaLabel,
  previousLabel,
  nextLabel,
  goToImageLabel,
  firstNameLabel,
  firstNamePlaceholder,
  mailLabel,
  mailPlaceholder,
  phoneLabel,
  phonePlaceholder,
  messageLabel,
  messagePlaceholder,
  submitLabel,
  workerUrl,
  venueSlug,
} = Astro.props;

// the section can appear more than once on a page, and a label only points at
// its own field if the ids are unique
const uid = crypto.randomUUID().slice(0, 8);
---

<Section spacing="m">
  <TwoBlocks>
    <div slot="first" class="media">
      <MiniCarousel
        {images}
        label={mediaLabel}
        {previousLabel}
        {nextLabel}
        {goToImageLabel}
      />
    </div>

    <div slot="second" class="panel">
      <div class="heading">
        <Badge color="light">{badge}</Badge>

        <Text as="h2" variant="title-h4">{title}</Text>
      </div>

      <musiquiz-contact-form
        data-worker-url={`${workerUrl}/form/client-contact`}
        data-venue-slug={venueSlug}
        data-uid={uid}
      >
        <form class="form">
          <div class="fields">
            <TextField
              id={`contact-${uid}-first-name`}
              name="firstName"
              type="text"
              autocomplete="given-name"
              tone="plain"
              label={firstNameLabel}
              placeholder={firstNamePlaceholder}
              required
            />

            <TextField
              id={`contact-${uid}-mail`}
              name="mail"
              type="email"
              autocomplete="email"
              tone="plain"
              label={mailLabel}
              placeholder={mailPlaceholder}
              required
            />

            <TextField
              id={`contact-${uid}-phone`}
              name="phone"
              type="tel"
              autocomplete="tel"
              tone="plain"
              label={phoneLabel}
              placeholder={phonePlaceholder}
            />

            <TextField
              as="textarea"
              id={`contact-${uid}-message`}
              name="message"
              tone="plain"
              label={messageLabel}
              placeholder={messagePlaceholder}
              required
            />
          </div>

          <Button type="submit" tone="blue">{submitLabel}</Button>
        </form>
      </musiquiz-contact-form>
    </div>
  </TwoBlocks>
</Section>

<style>
  .media {
    display: none;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6);
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-l);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  musiquiz-contact-form {
    display: contents;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    align-items: flex-start;
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: stretch;
  }

  /* 60rem — two columns stop fitting (styles/breakpoints.css) */
  @media (width >= 60rem) {
    .media {
      display: block;
    }

    .panel {
      padding: var(--space-10);
    }
  }
</style>

<script>
  // todo: move this logic to web: packages/ui must stay presentational only
  class MusiquizContactForm extends HTMLElement {
    connectedCallback() {
      const workerUrl = this.dataset.workerUrl;
      const venueSlug = this.dataset.venueSlug;
      const form = this.querySelector("form");
      if (!workerUrl || !venueSlug || !form) return;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const data = new FormData(form);

        const payload = {
          venueSlug,
          firstName: String(data.get("firstName") ?? ""),
          mail: String(data.get("mail") ?? ""),
          phone: String(data.get("phone") ?? ""),
          message: String(data.get("message") ?? ""),
        };

        try {
          const response = await fetch(workerUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          console.log(response.status, await response.text());
        } catch (error) {
          console.error(error);
        }
      });
    }
  }

  customElements.define("musiquiz-contact-form", MusiquizContactForm);
</script>
