---
import Badge from "./Badge.astro";
import Button from "./primitives/Button.astro";
import MiniCarousel from "./primitives/MiniCarousel.astro";
import Text from "./primitives/Text.astro";
import TextField from "./primitives/TextField.astro";
import TwoBlocks from "./primitives/TwoBlocks.astro";
import Section from "./Section.astro";
import type { ImageSource } from "./types";

interface Props {
  badge: string;
  title: string;
  images: ImageSource[];
  mediaLabel: string;
  previousLabel: string;
  nextLabel: string;
  goToImageLabel: string;
  firstNameLabel: string;
  firstNamePlaceholder: string;
  mailLabel: string;
  mailPlaceholder: string;
  phoneLabel: string;
  phonePlaceholder: string;
  messageLabel: string;
  messagePlaceholder: string;
  submitLabel: string;
  pendingLabel: string;
  successMessage: string;
  failureMessage: string;
  firstNameMaxLength: number;
  mailMaxLength: number;
  phoneMaxLength: number;
  messageMaxLength: number;
}

const {
  badge,
  title,
  images,
  mediaLabel,
  previousLabel,
  nextLabel,
  goToImageLabel,
  firstNameLabel,
  firstNamePlaceholder,
  mailLabel,
  mailPlaceholder,
  phoneLabel,
  phonePlaceholder,
  messageLabel,
  messagePlaceholder,
  submitLabel,
  pendingLabel,
  successMessage,
  failureMessage,
  firstNameMaxLength,
  mailMaxLength,
  phoneMaxLength,
  messageMaxLength,
} = Astro.props;

// the section can appear more than once on a page, and a label only points at
// its own field if the ids are unique
const uid = crypto.randomUUID().slice(0, 8);
---

<Section spacing="m">
  <TwoBlocks>
    <div slot="first" class="media">
      <MiniCarousel
        {images}
        label={mediaLabel}
        {previousLabel}
        {nextLabel}
        {goToImageLabel}
      />
    </div>

    <div slot="second" class="panel">
      <div class="heading">
        <Badge color="light">{badge}</Badge>

        <Text as="h2" variant="title-h4">{title}</Text>
      </div>

      <form class="form" data-contact-form>
        <fieldset class="fields" data-fields>
          <TextField
            id={`contact-${uid}-first-name`}
            name="firstName"
            type="text"
            autocomplete="given-name"
            tone="plain"
            label={firstNameLabel}
            placeholder={firstNamePlaceholder}
            maxlength={firstNameMaxLength}
            required
          />

          <TextField
            id={`contact-${uid}-mail`}
            name="mail"
            type="email"
            autocomplete="email"
            tone="plain"
            label={mailLabel}
            placeholder={mailPlaceholder}
            maxlength={mailMaxLength}
            required
          />

          <TextField
            id={`contact-${uid}-phone`}
            name="phone"
            type="tel"
            autocomplete="tel"
            tone="plain"
            label={phoneLabel}
            placeholder={phonePlaceholder}
            maxlength={phoneMaxLength}
          />

          <div class="message-field">
            <TextField
              as="textarea"
              id={`contact-${uid}-message`}
              name="message"
              tone="plain"
              label={messageLabel}
              placeholder={messagePlaceholder}
              maxlength={messageMaxLength}
              required
            />

            <p class="counter" data-counter aria-hidden="true"></p>
          </div>
        </fieldset>

        <div class="submit-row">
          <Button type="submit" tone="blue" data-submit>
            <span data-submit-label>{submitLabel}</span>
            <span data-pending-label hidden>{pendingLabel}</span>
          </Button>

          <p
            class="status failure"
            role="alert"
            tabindex="-1"
            data-failure
            hidden
          >
            {failureMessage}
          </p>

          <p
            class="status success"
            role="status"
            tabindex="-1"
            data-success
            hidden
          >
            {successMessage}
          </p>
        </div>
      </form>
    </div>
  </TwoBlocks>
</Section>

<style>
  .media {
    display: none;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6);
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-l);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    align-items: flex-start;
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: stretch;

    /* a fieldset carries UA chrome and a min-inline-size of min-content, which
       would stop the fields shrinking */
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* the message sits beside the button rather than under it: the row is already
     as tall as the button, so revealing it moves nothing */
  .submit-row {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    align-self: stretch;
  }

  .message-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-end;
  }

  .counter {
    font: var(--paragraph-s);
    color: var(--color-text-muted);
  }

  .counter[data-near-cap] {
    color: var(--color-text-error);
  }

  .status {
    min-inline-size: 0;
    font: var(--paragraph-base);
  }

  .failure {
    color: var(--color-text-error);
  }

  .success {
    color: var(--color-text-success);
  }

  /* 60rem — two columns stop fitting (styles/breakpoints.css) */
  @media (width >= 60rem) {
    .media {
      display: block;
    }

    .panel {
      padding: var(--space-10);
    }
  }
</style>
