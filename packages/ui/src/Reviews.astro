---
import Badge from "./Badge.astro";
import Text from "./primitives/Text.astro";
import Section from "./Section.astro";

interface Props {
  widgetId: string;
  badge: string;
  title: string;
  surface?: "default" | "muted";
}

const { widgetId, badge, title, surface = "default" } = Astro.props;
---

<Section surface={surface === "muted" ? "muted" : "default"} width="wide">
  <div class="reviews">
    <div class="heading">
      <Badge color="light">{badge}</Badge>

      <Text as="h2" variant="title-h2">{title}</Text>
    </div>

    <div class="widget">
      <script
        is:inline
        defer
        async
        src={`https://cdn.trustindex.io/loader.js?${widgetId}`}></script>
    </div>
  </div>
</Section>

<style>
  .reviews {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .heading {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  /* 60rem — reviews columns stacked. see styles/breakpoints.css */
  @media (width >= 60rem) {
    .reviews {
      flex-direction: row;
      gap: var(--space-20);
      align-items: flex-start;
    }

    .heading {
      inline-size: 325px;
    }

    .widget {
      flex: 1;
      min-inline-size: 0;
    }
  }
</style>
