---
import GameOffer from "./prices/GameOffer.astro";
import Button from "./primitives/Button.astro";
import Text from "./primitives/Text.astro";
import Section from "./Section.astro";
import type { PriceOffer } from "./types";

interface Props {
  title: string;
  surface?: "default" | "muted";
  // every game the venue runs. empty when it runs none yet
  games: PriceOffer[];
  perPersonLabel: string;
}

const { title, surface = "muted", games, perPersonLabel } = Astro.props;

// two prices sections on one page would otherwise share a radio group and
// fight over which game is selected
const group = `prices-${crypto.randomUUID()}`;
---

<Section {surface} width="content">
  <div class="prices">
    <Text as="h2" variant="title-h2">{title}</Text>

    {
      games.length > 0 && (
        <div class="picker">
          {games.map((game, index) => (
            <>
              <Button
                as="label"
                tone="light"
                class:list={["choice", games.length === 1 && "only"]}
              >
                <input
                  type="radio"
                  name={group}
                  value={game.name}
                  checked={index === 0}
                />
                {game.name}
              </Button>

              <div class="panel">
                <GameOffer offer={game} {perPersonLabel} />
              </div>
            </>
          ))}
        </div>
      )
    }

    <div class="actions">
      <Button tone="light" icon="arrow-right" iconPosition="trailing"
        >Découvrez le Pack Activités Musi'Quiz + Pixel Games</Button
      >
      <Button tone="blue">Réservez votre activité</Button>
    </div>
  </div>
</Section>

<style>
  .prices {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    text-align: center;
  }

  /* every choice is followed in the markup by the panel it reveals, so the
     panel can be selected from the checked radio. `order` then pulls the
     choices back up into a single row above the panels */
  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  .choice {
    order: 1;
  }

  /* with a single game there is nothing to choose between */
  .choice.only {
    display: none;
  }

  .choice input {
    position: absolute;
    width: 1px;
    height: 1px;
    /* clipped rather than `display: none`, which would take the radio out of
       the tab order and off the accessibility tree */
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  .panel {
    order: 2;
    flex: 1 0 100%;
    display: none;
    /* the row of choices already carries the section's gap */
    margin-block-start: var(--space-6);
  }

  .choice:has(input:checked) + .panel {
    display: block;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
</style>
