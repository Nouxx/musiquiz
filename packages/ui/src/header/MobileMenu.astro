---
import { MODAL_ID } from "../Header.astro";
import Button from "../primitives/Button.astro";
import type { IconName } from "../lib/icons";
import IconChip from "../primitives/IconChip.astro";
import Link from "../primitives/Link.astro";
import MenuButton from "../primitives/MenuButton.astro";
import RemoteImage from "../primitives/RemoteImage.astro";
import Text from "../primitives/Text.astro";
import { linkTarget } from "../lib/linkTarget";
import type { CtaLink, ImageSource, NavLink, NavMenu } from "../types";

type ContactLine = { label: string; url: string };

interface Props {
  logo: ImageSource;
  linksTree: (NavLink | NavMenu)[];
  additionalMobileMenuLink?: NavLink;
  cta: CtaLink;
  closeLabel: string;
  menuLabel?: string;
  languageSwitch?: { url: string; icon: IconName; label: string };
  contact: {
    address?: ContactLine;
    phone: ContactLine;
    mail: ContactLine;
  };
}

const {
  logo,
  linksTree,
  cta,
  closeLabel,
  menuLabel = "Menu",
  languageSwitch,
  contact,
  additionalMobileMenuLink,
} = Astro.props;

const hasSocials = Astro.slots.has("socials");

const groups = additionalMobileMenuLink
  ? [...linksTree, additionalMobileMenuLink]
  : linksTree;

const { address, phone, mail } = contact;
---

<dialog
  id={MODAL_ID}
  data-mobile-menu
  class="mobile-menu"
  aria-label={menuLabel}
  autofocus
>
  <div class="top">
    {
      languageSwitch && (
        <Link
          url={languageSwitch.url}
          ariaLabel={languageSwitch.label}
          underline={false}
        >
          <IconChip
            name={languageSwitch.icon}
            tone="muted"
            size="l"
            interactive
          />
        </Link>
      )
    }

    <form method="dialog" class="close-form">
      <button class="close" aria-label={closeLabel}>
        <IconChip name="cross" tone="muted" size="l" interactive />
      </button>
    </form>
  </div>

  <div class="sheet">
    {/* eager: because the logo loads only when the modal appears */}
    <RemoteImage image={logo} variant="menu-logo" loading="eager" />

    <ul class="links">
      {
        groups.map((item) =>
          "links" in item ? (
            <li class="group">
              {/* its own exclusive group: the desktop nav's `header-nav`
                  details sit in the same DOM */}
              <details name="mobile-nav">
                <MenuButton
                  as="summary"
                  icon="angle-down"
                  current={item.current}
                >
                  {item.label}
                </MenuButton>

                <ul class="panel">
                  {item.links.map((link) => (
                    <li>
                      <MenuButton
                        href={link.url}
                        {...linkTarget(link.external)}
                        current={link.current}
                      >
                        {link.label}
                      </MenuButton>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <MenuButton
                href={item.url}
                {...linkTarget(item.external)}
                current={item.current}
              >
                {item.label}
              </MenuButton>
            </li>
          ),
        )
      }
    </ul>

    <div class="contact">
      {
        address &&
          (address.url ? (
            <Link url={address.url} underline={false}>
              <Text variant="paragraph-s">{address.label}</Text>
            </Link>
          ) : (
            <Text variant="paragraph-s">{address.label}</Text>
          ))
      }

      <div class="reach">
        <Link url={phone.url} underline={false}>
          <Text variant="paragraph-s">{phone.label}</Text>
        </Link>
        -
        <Link url={mail.url} underline={false}>
          <Text variant="paragraph-s">{mail.label}</Text>
        </Link>
      </div>
    </div>

    {/* a direct child of the sheet: sticky only pins inside its parent */}
    <div class="cta">
      <Button
        as="a"
        href={cta.url}
        {...linkTarget(cta.external)}
        tone="red"
        size="l"
      >
        {cta.label}
      </Button>
    </div>

    {
      hasSocials && (
        <ul class="socials">
          <slot name="socials" />
        </ul>
      )
    }
  </div>
</dialog>

<script>
  // mobile menu nav fallback for the browsers that ignore commandfor
  // where the attributes are inert and the burger would do nothing
  if (!("commandForElement" in HTMLButtonElement.prototype)) {
    const menu =
      document.querySelector<HTMLDialogElement>("[data-mobile-menu]");

    document
      .querySelector<HTMLButtonElement>("[data-burger]")
      ?.addEventListener("click", () => menu?.showModal());
  }
</script>

<style>
  .mobile-menu {
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100dvh;
    max-block-size: 100dvh;
    padding: 0;
    overflow-y: auto;

    /* keeps focused links clear of the sticky CTA: 46px button + strip padding */
    scroll-padding-block-end: calc(46px + 2 * var(--space-6));
    color: var(--color-text-on-media);
    background-image: var(--color-surface-vivid-menu);
    border: 0;

    /* `autofocus` lands focus on the dialog, not the first link: iOS paints that one as focus-visible after a tap */
    outline: none;
  }

  .top {
    position: fixed;
    inset-block-start: var(--space-4);
    inset-inline: var(--space-6);
    display: flex;
    gap: var(--space-6);
    align-items: flex-end;
    justify-content: space-between;
  }

  .close-form {
    margin-inline-start: auto;
  }

  .close:active :global(.icon-chip) {
    background:
      linear-gradient(var(--color-fill-muted) 0 0) padding-box,
      var(--color-border-brand) border-box;
    border-color: transparent;
  }

  .sheet {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-block-size: 100%;
    padding-block: var(--space-10);
    padding-inline: var(--space-6);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;

    /* collapses to 0 under overflow, unlike `space-between` */
    margin-block: auto;
    padding-block: var(--space-10);
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
    padding-block-start: var(--space-1);
  }

  .panel :global(.menu-button[aria-current]) {
    background-image: none;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
    align-self: stretch;
    text-align: center;
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    justify-content: center;
  }

  /* its padding is the gap around the button, so the resting layout keeps it */
  .cta {
    position: sticky;
    inset-block-end: 0;
    display: flex;
    justify-content: center;
    align-self: stretch;
    margin-inline: calc(-1 * var(--space-6));
    padding: var(--space-6);

    /* the gradient behind never moves, so its blur reads as the gradient */
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(transparent, #000 var(--space-6));
  }

  .cta:last-child {
    margin-block-end: calc(-1 * var(--space-6));
  }

  .socials {
    display: flex;
    gap: var(--space-4);
  }
</style>
