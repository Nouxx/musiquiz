---
import Text from "./primitives/Text.astro";

interface Props {
  // the sheet's Couleur axis: `dark` is the translucent pill that sits on
  // media, `light` the opaque one for plain surfaces
  color?: "dark" | "light";
  size?: "large" | "small";
  // the sheet draws the badge level, but every page that uses one tilts it
  tilt?: boolean;
}

const { color = "dark", size = "large", tilt = true } = Astro.props;
---

<span class:list={["badge", color, size, { tilt }]}>
  <Text variant={size === "large" ? "paragraph-base-sm" : "paragraph-s-sm"}>
    <slot />
  </Text>
</span>

<style>
  .badge {
    position: relative;
    display: inline-flex;
    align-items: center;

    /* 999px, not the sheet's 24px: at either size the radius already exceeds
       half the height, so the two render identically as a pill — and this one
       stays a pill if the label ever wraps to a second line */
    border-radius: 999px;
  }

  .large {
    padding: var(--space-2) var(--space-5);
  }

  .small {
    padding: var(--space-1) var(--space-3);
  }

  .dark {
    color: var(--color-text-on-media);
    background-color: var(--color-surface-translucent);

    /* only on the translucent variant — behind `light`'s opaque fill there is
       nothing to blur, and the layer would still cost a compositing pass.
       Prefixed too: Safari only dropped `-webkit-` at 18, and nothing in the
       repo autoprefixes (no browserslist, no postcss). */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .light {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  /* INVENTED direction: the sheet gives the 2deg, no sheet says which way.
     Taken from the homepage cover mockup — right end up, left end down. */
  .tilt {
    transform: rotate(-2deg);
  }

  /* the brand gradient is an image, so it cannot go on `border-color`, and the
     padding-box/border-box background trick does not work here either: the
     fill is translucent, so the gradient shows through the whole pill instead
     of only its edge. A masked ring keeps the fill see-through.

     Figma exports this as `border-image-source`, which is not usable: border
     images ignore `border-radius` and would square off the corners.

     The uneven padding is the sheet's 1px/1px/3px/1px border. Drawing it as an
     overlay rather than a real border is also what keeps the box at the
     sheet's height, where the stroke sits inside the padding. */
  .badge::before {
    position: absolute;
    inset: 0;
    padding: 1px 1px 3px;
    background-image: var(--color-border-brand);
    border-radius: inherit;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    content: "";
  }
</style>
