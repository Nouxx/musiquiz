---
import Button from "../primitives/Button.astro";
import Icon from "../primitives/Icon.astro";

interface Props {
  submitLabel: string;
  pendingLabel: string;
  successLabel: string;
  failureLabel: string;
}

const { submitLabel, pendingLabel, successLabel, failureLabel } = Astro.props;
---

<form class="newsletter" data-newsletter-form>
  <fieldset class="newsletter-fields" data-fields>
    <slot />
    <div class="newsletter-consent">
      <slot name="consent" />
    </div>
  </fieldset>

  <Button type="submit" tone="red" size="m" data-submit>
    <Fragment slot="icon">
      <span data-button-icon data-state="pending" hidden>
        <Icon name="hourglass" size="m" />
      </span>
      <span data-button-icon data-state="success" hidden>
        <Icon name="check-circle" size="m" />
      </span>
      <span data-button-icon data-state="failure" hidden>
        <Icon name="cross" size="m" />
      </span>
    </Fragment>
    <span aria-live="polite">
      <span data-state="submit">{submitLabel}</span>
      <span data-state="pending" hidden>{pendingLabel}</span>
      <span data-state="success" hidden>{successLabel}</span>
      <span data-state="failure" hidden>{failureLabel}</span>
    </span>
  </Button>
</form>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    inline-size: min(25rem, 100%);
  }

  .newsletter-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: stretch;

    /* a fieldset carries UA chrome and a min-inline-size of min-content, which
       would stop the fields shrinking */
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .newsletter-consent {
    color: var(--color-text-on-brand-muted);
  }
</style>
