---
import Badge from "./Badge.astro";
import Button from "./primitives/Button.astro";
import Card from "./primitives/Card.astro";
import Icon from "./primitives/Icon.astro";
import RichText from "./primitives/RichText.astro";
import Section from "./Section.astro";
import { linkTarget } from "./lib/linkTarget";
import type { CtaLink, RichTextNode } from "./types";

interface Props {
  summaryBadge: string;
  summary: RichTextNode[];
  rating?: {
    /** out of 5, whole */
    stars: number;
    /** @example "4,7/5 sur 421 avis" */
    label: string;
    starsLabel: string;
  };
  cta: CtaLink;
}

const { summaryBadge, summary, rating, cta } = Astro.props;
---

<Section spacing="m">
  <div class="intro">
    <Card border="custom" class="summary">
      <Badge color="red" border="red-dark">{summaryBadge}</Badge>

      <RichText value={summary} variant="paragraph-xl" />
    </Card>

    {
      rating && (
        <div>
          <Badge color="light" border="muted" tilt={false}>
            <span class="rating">
              <span class="stars" role="img" aria-label={rating.starsLabel}>
                {[1, 2, 3, 4, 5].map((star) => (
                  <span class:list={{ muted: star > rating.stars }}>
                    <Icon name="star" size="s" />
                  </span>
                ))}
              </span>
              {rating.label}
            </span>
          </Badge>
        </div>
      )
    }

    <div>
      <Button as="a" href={cta.url} {...linkTarget(cta.external)} tone="red">
        {cta.label}
      </Button>
    </div>
  </div>
</Section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    max-inline-size: var(--size-article);
    margin-inline: auto;
  }

  .intro :global(.summary) {
    --card-ring-inset: 2px 6px 6px 2px;
    --card-ring-color: var(--color-border-red);

    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-6);
    color: var(--red-900);
    background-color: var(--red-100);
  }

  .rating {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
  }

  .stars {
    display: inline-flex;
    gap: 2px;
    color: var(--yellow-600);
  }

  .muted {
    color: var(--grey-400);
  }
</style>
