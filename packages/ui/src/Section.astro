---
interface Props {
  surface?: "default" | "vivid" | "muted";
  spacing?: "l" | "m";
  // `content` reads as a column of text and caps at `--size-content`. `wide` is
  // for sections composed edge to edge, and caps at the 1728px frame the Figma
  // sheets are drawn at, with the wider gutter that frame uses.
  width?: "content" | "wide";
  id?: string;
}

const { surface = "default", spacing = "l", width = "content", id } = Astro.props;
---

<section
  class:list={["section", surface, `width-${width}`]}
  style={{ "--section-spacing": `var(--space-section-${spacing})` }}
  {id}
>
  <div class="content"><slot /></div>
</section>

<style>
  .section {
    padding-block: var(--section-spacing);
    padding-inline: var(--space-6);

    /* a component may bleed a scroll port out to the viewport edge with a
       `calc(50% - 50vw)` margin (see Reviews). `100vw` counts the classic
       scrollbar that Windows draws and the document width does not, so without
       this the bleed overshoots by its width and the page scrolls sideways.
       `clip` rather than `hidden`: it creates no scroll container, and leaves
       `overflow-y` visible instead of forcing it to `auto`. */
    overflow-x: clip;
  }

  .width-wide {
    padding-inline: var(--space-gutter-wide);
  }

  .content {
    max-inline-size: var(--size-content);
    margin-inline: auto;
  }

  .width-wide .content {
    max-inline-size: var(--size-content-wide);
  }

  .vivid {
    color: var(--color-text-on-brand);
    background-image: var(--color-surface-vivid);
  }

  .muted {
    background-color: var(--color-surface-muted);
  }
</style>
