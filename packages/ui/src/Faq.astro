---
import Badge from "./Badge.astro";
import Accordion from "./primitives/Accordion.astro";
import AccordionItem from "./primitives/AccordionItem.astro";
import DriftingColumns from "./primitives/DriftingColumns.astro";
import RichText from "./primitives/RichText.astro";
import Text from "./primitives/Text.astro";
import Section from "./Section.astro";
import type { FaqQuestion, ImageSource } from "./types";

interface Props {
  badge: string;
  title: string;
  questions: FaqQuestion[];
  images: ImageSource[];
}

const { badge, title, questions, images } = Astro.props;

// two FAQs on a page must not close each other's questions
const groupName = `faq-${crypto.randomUUID().slice(0, 8)}`;
---

<Section spacing="m">
  <div class="faq">
    <div class="panel">
      <div class="heading">
        <Badge color="light">{badge}</Badge>

        <Text as="h2" variant="title-h3">{title}</Text>
      </div>

      <Accordion>
        {
          questions.map((entry: FaqQuestion, index: number) => (
            <AccordionItem
              name={groupName}
              question={entry.question}
              open={index === 0}
            >
              <RichText value={entry.answer} variant="paragraph-s" />
            </AccordionItem>
          ))
        }
      </Accordion>
    </div>

    <DriftingColumns {images} />
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-10);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  /* 72rem — FAQ image strip shown. see styles/breakpoints.css */
  @media (width >= 72rem) {
    .faq {
      grid-template-columns: minmax(0, 1fr) calc(260px * 2 + var(--space-6));
      gap: 120px;
      align-items: center;
    }
  }
</style>
