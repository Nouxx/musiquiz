---
import Badge from "./Badge.astro";
import Accordion from "./primitives/Accordion.astro";
import AccordionItem from "./primitives/AccordionItem.astro";
import Card from "./primitives/Card.astro";
import RemoteImage from "./primitives/RemoteImage.astro";
import RichText from "./primitives/RichText.astro";
import Text from "./primitives/Text.astro";
import Section from "./Section.astro";
import type { FaqQuestion, ImageSource } from "./types";

interface Props {
  badge: string;
  title: string;
  questions: FaqQuestion[];
  images: ImageSource[];
}

const { badge, title, questions, images } = Astro.props;

// the photo frame and the space under it
const IMAGE_BLOCK_PX = 455;
const IMAGE_GAP_PX = 24;

const SCROLL_SPEED_PX_PER_SEC = 30;

// start the same animation that many pixels early.
const RIGHT_COLUMN_OFFSET_PX = 240;

const columns = [
  images.filter((_, index) => index % 2 === 0),
  images.filter((_, index) => index % 2 !== 0),
];

function durationSeconds(count: number) {
  const seconds =
    (count * (IMAGE_BLOCK_PX + IMAGE_GAP_PX)) / SCROLL_SPEED_PX_PER_SEC;

  return seconds.toFixed(2);
}

const rightColumnDelaySeconds =
  -RIGHT_COLUMN_OFFSET_PX / SCROLL_SPEED_PX_PER_SEC;

// two FAQs on a page must not close each other's questions
const groupName = `faq-${crypto.randomUUID().slice(0, 8)}`;
---

<Section spacing="m">
  <div class="faq">
    <div class="panel">
      <div class="heading">
        <Badge color="light">{badge}</Badge>

        <Text as="h2" variant="title-h3">{title}</Text>
      </div>

      <Accordion>
        {
          questions.map((entry: FaqQuestion, index: number) => (
            <AccordionItem
              name={groupName}
              question={entry.question}
              open={index === 0}
            >
              <RichText value={entry.answer} variant="paragraph-s" />
            </AccordionItem>
          ))
        }
      </Accordion>
    </div>

    <div class="media">
      <div class="columns">
        {
          columns.map((column, columnIndex) => (
            <div class="column">
              <div
                class:list={["track", columnIndex === 0 ? "down" : "up"]}
                style={{
                  "--faq-column-duration": `${durationSeconds(column.length)}s`,
                  "--faq-column-delay":
                    columnIndex === 0 ? "0s" : `${rightColumnDelaySeconds}s`,
                }}
              >
                <ul class="set">
                  {column.map((image) => (
                    <li class="item">
                      <Card border="thick" class="frame">
                        <RemoteImage image={image} variant="faq-media" />
                      </Card>
                    </li>
                  ))}
                </ul>

                {/* the second half exists only to make the loop seamless, so it is hidden from assistive tech rather than read out twice */}
                <ul class="set clone" aria-hidden="true">
                  {column.map((image) => (
                    <li class="item">
                      <Card border="thick" class="frame">
                        <RemoteImage
                          image={{ ...image, alt: "" }}
                          variant="faq-media"
                        />
                      </Card>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-10);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  /* prevent a phone from fetching any of these photos */
  .media {
    display: none;
  }

  /* the strip must never decide how tall the section is: the accordion does,
     and a column of photos is several times taller than it. So the columns are
     lifted out of flow — an absolutely positioned layer contributes nothing to
     the grid row, and then fills whatever height the accordion settled on. */
  .columns {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, 260px);
    gap: var(--space-6);
  }

  /* 72rem — FAQ image strip shown. see styles/breakpoints.css */
  @media (width >= 72rem) {
    .faq {
      grid-template-columns: minmax(0, 1fr) calc(260px * 2 + var(--space-6));
      gap: 120px;
      align-items: center;
    }

    .media {
      position: relative;
      display: block;
      align-self: stretch;
      margin-block: calc(-1 * var(--section-spacing));
      overflow: hidden;
    }
  }

  .track {
    animation-duration: var(--faq-column-duration);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-delay: var(--faq-column-delay);
  }

  .down {
    animation-name: drift-down;
  }

  .up {
    animation-name: drift-up;
  }

  .media:hover .track {
    animation-play-state: paused;
  }

  .column {
    overflow: hidden;
  }

  .set {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .item {
    padding-block-end: var(--space-6);
  }

  .frame {
    aspect-ratio: 260 / 455;
  }

  .frame > :global(picture) {
    display: block;
    block-size: 100%;
  }

  @keyframes drift-down {
    from {
      transform: translateY(-50%);
    }

    to {
      transform: translateY(0);
    }
  }

  @keyframes drift-up {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-50%);
    }
  }

  /* no need to add a scroller: images are decorative here */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }

    .clone {
      display: none;
    }
  }
</style>
