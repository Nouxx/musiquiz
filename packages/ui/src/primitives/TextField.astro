---
import type { HTMLAttributes } from "astro/types";

import Text from "./Text.astro";

type Options = {
  id: string;
  label: string;
  /** `light` fills the control, `plain` lets the surface behind it show */
  tone?: "light" | "plain";
  /** only read when rendering a textarea */
  rows?: number;
};

// exported because rendering through a dynamic `<Tag>` leaves Astro's
// generated types with no reference to `Props`, and `noUnusedLocals` then
// reports it as unused
export type Props = Options &
  (
    | (Omit<HTMLAttributes<"input">, "class" | "id"> & { as?: "input" })
    | (Omit<HTMLAttributes<"textarea">, "class" | "id"> & { as: "textarea" })
  );

const {
  as: Tag = "input",
  id,
  label,
  tone = "light",
  rows = 3,
  "aria-describedby": describedBy,
  ...rest
} = Astro.props;

const errorId = `${id}-error`;
---

<div class:list={["field", tone]}>
  <label for={id}>
    <Text variant="title-base">{label}</Text>
  </label>
  <Tag
    {...rest}
    {id}
    class="input"
    aria-describedby={[describedBy, errorId].filter(Boolean).join(" ")}
    rows={Tag === "textarea" ? rows : undefined}
  />
  <!-- always rendered so a client script only sets its text: a node created at
       runtime gets none of Astro's scoped styles -->
  <p id={errorId} class="error" hidden></p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    inline-size: 100%;
  }

  .input {
    padding-block: var(--space-3);
    padding-inline: var(--space-4);
    font: var(--paragraph-base);
    color: var(--color-text-on-light);
    border: 1px solid var(--color-border-light);
    border-block-end-width: 3px;
    border-radius: var(--radius-s);

    /* ignored by an input, and the only sensible axis for a textarea: growing
       sideways would break the column */
    resize: vertical;
  }

  .light .input {
    background: var(--color-fill-light);
  }

  .plain .input {
    background: transparent;
  }

  .input::placeholder {
    color: var(--color-text-placeholder);
  }

  .input[aria-invalid="true"] {
    border-color: var(--color-border-error);
  }

  .error {
    font: var(--paragraph-s);
    color: var(--color-text-error);
  }

  .input:focus-visible {
    outline: 2px solid var(--color-border-on-brand);
    outline-offset: 2px;
  }
</style>
