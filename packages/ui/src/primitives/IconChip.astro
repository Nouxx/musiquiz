---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

type Tone = "light" | "dark" | "muted";

const iconSizes = {
  s: "s", // 24px box, 14px icon
  m: "l", // 30px box, 20px icon
  l: "l", // 36px box, 20px icon
  xl: "xl", // 40px box, 24px icon
  xxl: "xxl", // 60px box, 30px icon
  xxxl: "xxl", // 80px box, 30px icon
} as const;

type Size = keyof typeof iconSizes;

interface Props {
  name: IconName;
  tone?: Tone;
  size?: Size;
  interactive?: boolean;
}

const { name, tone = "light", size = "xl", interactive = false } = Astro.props;
---

<span class:list={["icon-chip", tone, size, interactive && "interactive"]}>
  <Icon {name} size={iconSizes[size]} />
</span>

<style>
  .icon-chip {
    display: inline-flex;
    flex: none;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    color: var(--chip-text);
    background: var(--chip-fill);
    border: 1px solid var(--chip-border);
    border-radius: var(--radius-pill);
  }

  .interactive {
    --lift: 2px;

    box-shadow: 0 var(--lift) 0 var(--chip-border);
    transform: translateY(calc(2px - var(--lift)));

    transition:
      transform 120ms ease-out,
      box-shadow 120ms ease-out;
  }

  .interactive:hover {
    --lift: 1px;
  }

  .interactive:active {
    --lift: 0px;

    background:
      linear-gradient(var(--color-overlay-pressed) 0 0), var(--chip-fill);
    transition-duration: 0s;
  }

  .light {
    --chip-fill: var(--color-fill-light);
    --chip-border: var(--color-border-light);
    --chip-text: var(--color-text-on-light);
  }

  .dark {
    --chip-fill: var(--color-fill-dark);
    --chip-border: var(--color-border-dark);
    --chip-text: var(--color-text-on-dark);
  }

  .muted {
    --chip-fill: var(--color-fill-muted);
    --chip-border: var(--color-border-light);
    --chip-text: var(--color-text-on-light);
  }

  .s {
    inline-size: 1.5rem;
  }

  .m {
    inline-size: 1.875rem;
  }

  .l {
    inline-size: 2.25rem;
  }

  .xl {
    inline-size: 2.5rem;
  }

  .xxl {
    inline-size: 3.75rem;
  }

  .xxxl {
    inline-size: 5rem;
  }
</style>
