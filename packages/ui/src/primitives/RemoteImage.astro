---
import { Image, Picture } from "astro:assets";

type ImageSource = {
  url: string;
  // `width` and `height` describe the file `url` points at, not the size it is rendered at. Rendered size comes from the variant.
  width: number;
  height: number;
  mimeType: string;
  alt: string;
};

type Variant = keyof typeof variants;

interface Props {
  image: ImageSource;
  variant: Variant;
  loading?: "lazy" | "eager";
}

const variants = {
  "header-logo": {
    widths: [140, 200, 280, 400, 600],
    // 80rem = "header collapsed"
    sizes: "(width < 80rem) 140px, 200px",
  },
  "menu-logo": { widths: [144, 288, 432], sizes: "144px" },
  "footer-logo": {
    widths: [120, 160, 240, 320],
    sizes: "(width < 48rem) 120px, 160px",
  },
  "cover-logo": { widths: [200, 400, 600], sizes: "200px" },
  "cover-logo-side": {
    widths: [400, 800, 1200],
    // the cover sizes this one by ratio (31.75% of its frame) and wraps it
    // without a breakpoint, so there is no honest query to quote. 78rem is
    // where the frame stops growing and the logo settles at 396px; below the
    // wrap it runs between 200px and 290px. Both arms round up: an over-large
    // `sizes` costs a few bytes, an under-large one costs sharpness.
    sizes: "(width < 60rem) 300px, (width < 78rem) 31.75vw, 396px",
  },
  "payment-icon": { widths: [32, 64, 96], sizes: "32px" },
  cover: { widths: [640, 960, 1280, 1920, 2560], sizes: "100vw" },
};

const SVG_MIME_TYPE = "image/svg+xml";

const { image, variant, loading = "lazy" } = Astro.props;

const { widths, sizes } = variants[variant];

// astro only refuses to upscale when the source is an imported file: for a
// remote url it will happily generate a 192w rendition of a 64px upload. so
// drop anything wider than the source, and put the source itself back as the
// widest candidate when that dropped something
const fittingWidths = widths.filter((width) => width <= image.width);

const srcSetWidths =
  fittingWidths.length === widths.length
    ? fittingWidths
    : [...fittingWidths, image.width];
---

{
  image.mimeType === SVG_MIME_TYPE ? (
    // a vector needs no srcset
    <Image
      class={variant}
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      format="svg"
      loading={loading}
    />
  ) : (
    <Picture
      class={variant}
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      widths={srcSetWidths}
      sizes={sizes}
      formats={["avif", "webp"]}
      loading={loading}
    />
  )
}

<style>
  .header-logo {
    width: 140px;
    height: auto;
  }

  /* 80rem = "header collapsed" */
  @media (width >= 80rem) {
    .header-logo {
      width: 200px;
    }
  }

  .menu-logo {
    width: 144px;
    height: auto;
  }

  .footer-logo {
    width: 120px;
    height: auto;
  }

  @media (width >= 48rem) {
    .footer-logo {
      width: 160px;
    }
  }

  .cover-logo {
    width: 200px;
    height: auto;
  }

  /* no width of its own: PageCover's flex item is what sizes this logo, by
     ratio down to a floor, so a cap here would only fight it */
  .cover-logo-side {
    width: 100%;
    height: auto;
  }

  .payment-icon {
    width: 32px;
    height: auto;
  }

  .cover {
    width: 100%;
    height: auto;
  }
</style>
