---
import { Image, Picture } from "astro:assets";

type ImageSource = {
  url: string;
  // `width` and `height` describe the file `url` points at, not the size it is rendered at. Rendered size comes from the variant.
  width: number;
  height: number;
  mimeType: string;
  alt: string;
};

type Variant = keyof typeof variants;

interface Props {
  image: ImageSource;
  variant: Variant;
  loading?: "lazy" | "eager";
}

const variants = {
  "header-logo": {
    widths: [140, 200, 280, 400, 600],
    // 80rem = "header collapsed"
    sizes: "(width < 80rem) 140px, 200px",
  },
  "menu-logo": { widths: [144, 288, 432], sizes: "144px" },
  "footer-logo": {
    widths: [120, 160, 240, 320],
    sizes: "(width < 48rem) 120px, 160px",
  },
  "cover-logo": { widths: [200, 400, 600], sizes: "200px" },
  "cover-logo-side": {
    widths: [400, 800, 1200],
    // 78rem is where the frame stops growing and the logo settles at 396px
    sizes: "(width < 60rem) 300px, (width < 78rem) 31.75vw, 396px",
  },
  "payment-icon": { widths: [32, 64, 96], sizes: "32px" },
  "card-media": {
    widths: [300, 400, 600, 800],
    sizes: "(width < 48rem) 100vw, (width < 78rem) 33vw, 400px",
  },
  "carousel-media": { widths: [282, 564, 846], sizes: "282px" },
  // 60rem is the TwoBlocks split (styles/breakpoints.css)
  "deck-media": {
    widths: [400, 700, 1000, 1400],
    sizes: "(width < 60rem) 100vw, min(604px, 47vw)",
  },
  // hidden below 60rem, where the contact form takes the full width
  "mini-carousel-media": {
    widths: [400, 700, 1000, 1400],
    sizes: "(width < 60rem) 1px, min(604px, 47vw)",
  },
  // hidden below 60rem, where the tiers take the full width
  "prices-media": {
    widths: [400, 700, 1000, 1400],
    sizes: "(width < 60rem) 1px, 60vw",
  },
  "review-avatar": { widths: [40, 80, 120], sizes: "40px" },
  // hidden below 72rem, where the FAQ drops its image strip and the accordion takes the full width (see styles/breakpoints.css)
  "faq-media": { widths: [260, 520, 780], sizes: "(width < 72rem) 1px, 260px" },
  "logo-strip": { widths: [120, 240, 360], sizes: "120px" },
  "logo-strip-large": { widths: [160, 320, 480], sizes: "160px" },
  cover: { widths: [640, 960, 1280, 1920, 2560], sizes: "100vw" },
};

const SVG_MIME_TYPE = "image/svg+xml";

const { image, variant, loading = "lazy" } = Astro.props;

const { widths, sizes } = variants[variant];

// astro only refuses to upscale when the source is an imported file: for a
// remote url it will happily generate a 192w rendition of a 64px upload. so
// drop anything wider than the source, and put the source itself back as the
// widest candidate when that dropped something
const fittingWidths = widths.filter((width) => width <= image.width);

const srcSetWidths =
  fittingWidths.length === widths.length
    ? fittingWidths
    : [...fittingWidths, image.width];
---

{
  image.mimeType === SVG_MIME_TYPE ? (
    // a vector needs no srcset
    <Image
      class={variant}
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      format="svg"
      loading={loading}
    />
  ) : (
    <Picture
      class={variant}
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      widths={srcSetWidths}
      sizes={sizes}
      formats={["avif", "webp"]}
      loading={loading}
    />
  )
}

<style>
  .header-logo {
    width: 140px;
    height: auto;
  }

  /* 80rem = "header collapsed" */
  @media (width >= 80rem) {
    .header-logo {
      width: 200px;
    }
  }

  .menu-logo {
    width: 144px;
    height: auto;
  }

  .footer-logo {
    width: 120px;
    height: auto;
  }

  @media (width >= 48rem) {
    .footer-logo {
      width: 160px;
    }
  }

  .cover-logo {
    width: 200px;
    height: auto;
  }

  /* should be sized by a parent Flex */
  .cover-logo-side {
    width: 100%;
    height: auto;
  }

  .payment-icon {
    width: 32px;
    height: auto;
  }

  .card-media {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .deck-media {
    width: 100%;
    height: auto;
    aspect-ratio: 612 / 374;
    object-fit: cover;
    object-position: center;
  }

  .carousel-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .mini-carousel-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .prices-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .faq-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .logo-strip {
    width: auto;
    height: var(--logos-box-block, 80px);
    max-width: var(--logos-box-inline, 120px);
    object-fit: contain;
  }

  .logo-strip-large {
    width: auto;
    height: var(--logos-box-block, 176px);
    max-width: var(--logos-box-inline, 160px);
    object-fit: contain;
  }

  .cover {
    width: 100%;
    height: auto;
  }
</style>
