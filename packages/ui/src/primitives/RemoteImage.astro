---
import { Image, Picture } from "astro:assets";

type ImageSource = {
  url: string;
  // `width` and `height` describe the file `url` points at, not the size it is rendered at. Rendered size comes from the variant.
  width: number;
  height: number;
  mimeType: string;
  alt: string;
};

type Variant = keyof typeof variants;

interface Props {
  image: ImageSource;
  variant: Variant;
  loading?: "lazy" | "eager";
}

const variants = {
  logo: { widths: [64, 128, 192], sizes: "64px" },
};

const SVG_MIME_TYPE = "image/svg+xml";

const { image, variant, loading = "lazy" } = Astro.props;

const { widths, sizes } = variants[variant];

// astro only refuses to upscale when the source is an imported file: for a
// remote url it will happily generate a 192w rendition of a 64px upload. so
// drop anything wider than the source, and put the source itself back as the
// widest candidate when that dropped something
const fittingWidths = widths.filter((width) => width <= image.width);

const srcSetWidths =
  fittingWidths.length === widths.length
    ? fittingWidths
    : [...fittingWidths, image.width];
---

{
  image.mimeType === SVG_MIME_TYPE ? (
    // a vector needs no srcset
    <Image
      class={variant}
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      format="svg"
      loading={loading}
    />
  ) : (
    <Picture
      class={variant}
      src={image.url}
      alt={image.alt}
      width={image.width}
      height={image.height}
      widths={srcSetWidths}
      sizes={sizes}
      formats={["avif", "webp"]}
      loading={loading}
    />
  )
}

<style>
  .logo {
    width: 64px;
    height: auto;
  }
</style>
