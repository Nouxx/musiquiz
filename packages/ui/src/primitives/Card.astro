---
import type { HTMLAttributes } from "astro/types";

type Border = "thin" | "thick" | "muted" | "translucent";

type Surface = "glass";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  as?: "div" | "article" | "li";
  border?: Border;
  surface?: Surface;
  class?: string;
}

const {
  as: Tag = "div",
  border = "thick",
  surface,
  class: className,
  ...rest
} = Astro.props;
---

<Tag {...rest} class:list={["card", border, surface, className]}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    border-radius: var(--radius-l);
    overflow: hidden; /* blocks anything would must escape the box */
  }

  .card::before {
    position: absolute;
    inset: 0;
    z-index: 1; /* keeps the border over content that bleeds to the edge */
    background-image: var(--color-border-brand);
    border-radius: inherit;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
    content: "";
  }

  .thin::before {
    padding: 1px 1px 3px;
  }

  .thick::before {
    padding: 2px 6px 6px 2px;
  }

  .muted::before {
    padding: 1px;
    background-image: none;
    background-color: var(--color-border);
  }

  /* the `thick` geometry with a flat light ring instead of the brand gradient,
     so the photo behind the card is what carries the colour */
  .translucent::before {
    padding: 2px 6px 6px 2px;
    background-image: none;
    background-color: var(--color-border-translucent);
  }

  .glass {
    background-color: var(--color-surface-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>
