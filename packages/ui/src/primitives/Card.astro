---
import type { HTMLAttributes } from "astro/types";

/**
 * `custom` sets nothing: the ring's geometry and paint are read from the
 * `--card-ring-*` properties the caller sets on this element instead. It exists
 * for rings that change with *runtime* state — a build-time prop cannot express
 * "gradient while the details is open", and leaving the variant classes off is
 * what keeps the caller's rules from fighting them in the cascade.
 */
type Border = "thin" | "thick" | "muted" | "translucent" | "custom";

type Surface = "glass";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  as?: "div" | "article" | "li" | "details";
  border?: Border;
  surface?: Surface;
  class?: string;
  /** use with `as="details"` */
  name?: string;
  open?: boolean;
}

const {
  as: Tag = "div",
  border = "thick",
  surface,
  class: className,
  ...rest
} = Astro.props;
---

<Tag {...rest} class:list={["card", border, surface, className]}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    border-radius: var(--card-radius, var(--radius-l));
    overflow: hidden; /* blocks anything would must escape the box */
  }

  .card::before {
    position: absolute;
    inset: 0;
    z-index: 1; /* keeps the border over content that bleeds to the edge */
    padding: var(--card-ring-inset, 2px 6px 6px 2px);
    background-color: var(--card-ring-color, transparent);
    background-image: var(--card-ring-image, none);
    border-radius: inherit;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
    content: "";
  }

  .thin {
    --card-ring-inset: 1px 1px 3px;
    --card-ring-image: var(--color-border-brand);
  }

  .thick {
    --card-ring-inset: 2px 6px 6px 2px;
    --card-ring-image: var(--color-border-brand);
  }

  .muted {
    --card-ring-inset: 1px;
    --card-ring-color: var(--color-border);
  }

  .translucent {
    --card-ring-inset: 2px 6px 6px 2px;
    --card-ring-color: var(--color-border-translucent);
  }

  .glass {
    background-color: var(--color-surface-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>
