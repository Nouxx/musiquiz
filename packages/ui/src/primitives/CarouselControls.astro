---
import ScrollArrow from "./ScrollArrow.astro";

interface Props {
  count: number;
  /** id of the scroll port these controls drive */
  controls: string;
  size?: "s" | "m";
  layout?: "centred" | "split";
  /**
   * how many slots the track shows per viewport, which decides how many
   * trailing dots can never be reached. `band` is Carousel's 1 / 3 / 5 ladder,
   * trimmed in CSS so the extra dots never flash before the script measures;
   * `one` always reaches every image, so nothing is trimmed.
   */
  slots?: "one" | "band";
  /**
   * lifts the arrows out of the row at 88rem so they hang off the sides of the
   * nearest positioned ancestor. That box owns `--gap` and, with the arrows
   * gone, is what the dots then centre themselves in.
   */
  flank?: boolean;
  previousLabel: string;
  nextLabel: string;
  goToImageLabel: string;
}

const {
  count,
  controls,
  size = "s",
  layout = "centred",
  slots = "one",
  flank = false,
  previousLabel,
  nextLabel,
  goToImageLabel,
} = Astro.props;

const positions = Array.from({ length: count }, (_, index) => index);
---

<div
  class:list={["controls", `size-${size}`, layout, `slots-${slots}`, { flank }]}
>
  <ol class="dots">
    {
      positions.map((index) => (
        <li>
          <button
            type="button"
            class="dot"
            aria-label={`${goToImageLabel} ${index + 1}`}
            aria-controls={controls}
            data-carousel-dot={index}
          />
        </li>
      ))
    }
  </ol>

  <div class="arrows">
    <ScrollArrow direction="previous" label={previousLabel} {controls} />

    <ScrollArrow direction="next" label={nextLabel} {controls} />
  </div>
</div>

<style>
  .controls {
    --dot-inline: 12px;
    --dot-block: 4px;
    --dot-inline-active: 16px;
    --dot-block-active: 6px;

    display: flex;
    gap: var(--space-6);
    align-items: center;
    inline-size: 100%;
  }

  .size-m {
    --dot-inline: 16px;
    --dot-block: 6px;
    --dot-inline-active: 20px;
    --dot-block-active: 8px;
  }

  .centred {
    justify-content: center;
  }

  .split {
    justify-content: space-between;
    padding-inline: var(--space-6);
  }

  .dots {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dot {
    display: block;
    inline-size: var(--dot-inline);
    block-size: var(--dot-block);
    padding: 0;
    background-color: var(--color-fill-indicator);
    border: none;
    border-radius: 1px;
    cursor: pointer;
    transition:
      inline-size 160ms ease-out,
      block-size 160ms ease-out,
      rotate 160ms ease-out,
      background-color 160ms ease-out;
  }

  .dot[aria-current="true"] {
    inline-size: var(--dot-inline-active);
    block-size: var(--dot-block-active);
    background-color: var(--color-fill-indicator-active);
    rotate: 10deg;
  }

  .arrows {
    display: flex;
    gap: var(--space-4);
  }

  /* 64rem — carousel slot count. see styles/breakpoints.css */
  @media (width >= 64rem) {
    /* an exact band has exactly `count - slots + 1` positions, so the trailing
       dots can be trimmed here rather than waiting for the script to measure —
       which is what keeps them from flashing on load. The peeking band has no
       fixed slot count, so there the script is the only way */
    .slots-band .dots > li:nth-last-child(-n + 2) {
      display: none;
    }
  }

  /* 88rem — carousel slot count. see styles/breakpoints.css */
  @media (width >= 88rem) {
    .slots-band .dots > li:nth-last-child(-n + 4) {
      display: none;
    }

    /* the arrows leave the row and hang off whatever positioned box the caller
       wrapped them in, `--scroll-arrow-size` + `--gap` clear of it, centred on
       that box's full height */
    .flank .arrows {
      position: absolute;
      inset-block: 0;
      inset-inline: calc(-1 * (var(--scroll-arrow-size) + var(--gap)));
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
    }

    .flank .arrows > :global(.scroll-arrow) {
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      transition: none;
    }
  }
</style>
