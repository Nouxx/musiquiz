---
import Link from "./Link.astro";
import type { RichTextSpan } from "../types";

interface Props {
  spans: RichTextSpan[];
}

const { spans } = Astro.props;
---

{
  spans.map((span) => {
    const lines = span.text
      .split("\n")
      .map((line, index) => (index > 0 ? [<br />, line] : line));

    const bold = span.bold ? <strong>{lines}</strong> : lines;
    const italic = span.italic ? <em>{bold}</em> : bold;
    const underline = span.underline ? <u>{italic}</u> : italic;
    const content = span.strike ? <s>{underline}</s> : underline;

    return span.href ? <Link url={span.href}>{content}</Link> : content;
  })
}

<style>
  /* the body face ships 400 and 600 only (apps/web/astro.config.mjs), so the default `bold` would be synthesized */
  strong {
    font-weight: 600;
  }
</style>
