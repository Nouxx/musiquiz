---
interface Props {
  /** in order of preference, the browser plays the first it can */
  sources: {
    src: string;
    /** @example 'video/mp4; codecs="av01.0.08M.08"' */
    type: string;
  }[];
}

const { sources } = Astro.props;

// no `autoplay`: the script starts it, so a visitor who turns motion off never downloads it
---

<video
  class="background-video"
  muted
  loop
  playsinline
  preload="none"
  aria-hidden="true"
  tabindex="-1"
  disablepictureinpicture
  data-background-video
>
  {sources.map(({ src, type }) => <source {src} {type} />)}
</video>

<style>
  .background-video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    pointer-events: none;
  }
</style>

<script>
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const videos = document.querySelectorAll<HTMLVideoElement>(
      "[data-background-video]",
    );

    // a refused autoplay (low power mode, data saver) leaves the poster showing
    await Promise.allSettled([...videos].map((video) => video.play()));
  }
</script>
