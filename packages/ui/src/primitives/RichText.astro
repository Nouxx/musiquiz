---
import RichTextSpans from "./RichTextSpans.astro";
import type { TextVariant } from "./Text.astro";
import Text from "./Text.astro";
import type { RichTextNode, SpaceScale } from "../types";

interface Props {
  value: RichTextNode[];
  variant?: TextVariant;
  gap?: SpaceScale;
}

const { value, variant = "paragraph-base", gap = "2" } = Astro.props;
---

{
  /*
   * Every node is a paragraph today. The type is a union so that the kinds the
   * CMS may grow into — a list, an image — arrive as new branches here rather
   * than as a reshape of what a caller passes.
   */
}
<div class="rich-text" style={{ "--rich-text-gap": `var(--space-${gap})` }}>
  {
    value.map((node) => (
      <Text as="p" variant={variant}>
        <RichTextSpans spans={node.spans} />
      </Text>
    ))
  }
</div>

<style>
  .rich-text {
    display: flex;
    flex-direction: column;
    gap: var(--rich-text-gap);
  }
</style>
