---
import type { HTMLAttributes } from "astro/types";
import Text from "./Text.astro";
import Icon, { type IconName } from "./Icon.astro";

interface Options {
  current?: boolean;
  icon?: IconName;
  iconPosition?: "leading" | "trailing";
}

// exported because rendering through a dynamic `<Tag>` leaves Astro's
// generated types with no reference to `Props`, and `noUnusedLocals` then
// reports it as unused
export type Props = Options &
  (
    | (HTMLAttributes<"a"> & { as?: "a"; href: string })
    | (HTMLAttributes<"button"> & { as: "button" })
    | (HTMLAttributes<"summary"> & { as: "summary" })
  );

const {
  as: Tag = "a",
  current,
  icon,
  iconPosition = "trailing",
  class: className,
  ...rest
} = Astro.props;

// `type` first so a caller can still pass `type="submit"` through `rest`
const attrs = {
  ...(Tag === "button" ? { type: "button" } : {}),
  ...rest,
} as Record<string, unknown>;
---

<Tag
  {...attrs}
  aria-current={current ? "page" : undefined}
  class:list={["menu-button", className]}
>
  {iconPosition === "leading" && icon && <Icon name={icon} size="s" />}
  <Text variant="title-base-xl"><slot /></Text>
  {iconPosition === "trailing" && icon && <Icon name={icon} size="s" />}
</Tag>

<style>
  .menu-button {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    justify-content: center;
    padding-block: clamp(0.375rem, 0.243rem + 0.563vw, 0.75rem);
    padding-inline: clamp(1rem, 0.824rem + 0.751vw, 1.5rem);
    color: var(--color-text-on-media);

    /* `<summary>` is a list-item by default; `inline-flex` drops its marker in Chrome and Firefox, this covers the rest */
    list-style: none;
    border-radius: 999px;

    transition: background-color 120ms ease-out;
  }

  .menu-button::-webkit-details-marker {
    display: none;
  }

  .menu-button:hover,
  .menu-button:focus-visible {
    background-color: var(--color-surface-on-media);
  }

  .menu-button[aria-current] {
    background-image: var(--color-fill-blue);
  }
</style>
