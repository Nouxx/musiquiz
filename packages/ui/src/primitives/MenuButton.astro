---
import type { HTMLAttributes } from "astro/types";
import Text from "./Text.astro";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Options {
  current?: boolean;
  icon?: IconName;
  iconPosition?: "leading" | "trailing";
}

// exported because rendering through a dynamic `<Tag>` leaves Astro's
// generated types with no reference to `Props`, and `noUnusedLocals` then
// reports it as unused
export type Props = Options &
  (
    | (HTMLAttributes<"a"> & { as?: "a"; href: string })
    | (HTMLAttributes<"button"> & { as: "button" })
    | (HTMLAttributes<"summary"> & { as: "summary" })
  );

const {
  as: Tag = "a",
  current,
  icon,
  iconPosition = "trailing",
  class: className,
  ...rest
} = Astro.props;

// `type` first so a caller can still pass `type="submit"` through `rest`
const attrs = {
  ...(Tag === "button" ? { type: "button" } : {}),
  ...rest,
} as Record<string, unknown>;

const currentValue = current
  ? Tag === "summary"
    ? "true"
    : "page"
  : undefined;
---

<Tag
  {...attrs}
  aria-current={currentValue}
  class:list={["menu-button", className]}
>
  {iconPosition === "leading" && icon && <Icon name={icon} size="s" />}
  <Text variant="title-base-xl"><slot /></Text>
  {iconPosition === "trailing" && icon && <Icon name={icon} size="s" />}
</Tag>

<style>
  .menu-button {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    justify-content: center;

    padding-block: clamp(0.25rem, 0.926rem - 0.751vw, 0.75rem);
    padding-inline: clamp(0.75rem, 1.764rem - 1.127vw, 1.5rem);
    color: var(--color-text-on-media);

    /* `<summary>` is a list-item by default; `inline-flex` drops its marker in Chrome and Firefox, this covers the rest */
    list-style: none;
    border-radius: 999px;

    transition: background-color 120ms ease-out;
  }

  .menu-button::-webkit-details-marker {
    display: none;
  }

  .menu-button:hover,
  .menu-button:focus-visible {
    background-color: var(--color-surface-on-media);
  }

  /* an open disclosure reads the same as hover. `:global` on the `<details>`
     because it belongs to the consumer's template and so carries the
     consumer's scope marker, never this component's */
  :global(details[open]) > .menu-button {
    background-color: var(--color-surface-on-media);
  }

  .menu-button[aria-current] {
    background-image: var(--color-fill-blue);
  }

  .menu-button :global(.musiquiz-icon) {
    transition: rotate 120ms ease-out;
  }

  :global(details[open]) > .menu-button :global(.musiquiz-icon) {
    rotate: 180deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-button,
    .menu-button :global(.musiquiz-icon) {
      transition: none;
    }
  }
</style>
