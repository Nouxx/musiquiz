---
// placeholder: only the social links use this, and they have no artwork yet.
// images that come from the cms go through RemoteImage instead
interface Props {
  alt?: string;
}

const { alt } = Astro.props;
---

<img class="image" alt={alt ?? ""} />

<style>
  .image {
    height: 24px;
    width: 35px;
  }
</style>
