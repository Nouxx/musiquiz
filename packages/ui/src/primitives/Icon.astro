---
import { icons, type IconName } from "../lib/icons";

const sizes = {
  s: "0.875rem", // 14px — icon inside a 24px contact chip
  m: "1.125rem", // 18px — trailing chevron in a secondary button
  l: "1.25rem", // 20px — leading flag in the language button
  xl: "1.5rem", // 24px — icon inside a 40px social chip
  xxl: "5rem", // 80px — the mark on a Detail Card
} as const;

export interface Props {
  name: IconName;
  size?: keyof typeof sizes;
}

const { name, size = "xl" } = Astro.props;

const markup = icons[name].replace(
  "<svg ",
  `<svg class="musiquiz-icon" style="--icon-size: ${sizes[size]}" aria-hidden="true" focusable="false" `,
);
---

<Fragment set:html={markup} />

<style is:global>
  /* global is necessary here because Astro stamps its `data-astro-cid-*` marker at compile
     time onto template elements only, so a scoped rule would never match an
     svg that arrives through `set:html`. `musiquiz-` prefixed to prevent collisions */
  .musiquiz-icon {
    display: block;
    inline-size: var(--icon-size);
    block-size: auto;
    fill: currentcolor; /* keep flags in correct colors */
    flex-shrink: 0;
  }
</style>
