---
import type { HTMLAttributes } from "astro/types";

import Text from "./Text.astro";

interface Props extends Omit<HTMLAttributes<"select">, "class" | "id"> {
  id: string;
  label: string;
  /** the disabled first option, shown until the visitor picks */
  placeholder: string;
  options: { value: string; label: string }[];
  /** `light` fills the control, `plain` lets the surface behind it show */
  tone?: "light" | "plain";
  /** draws the red asterisk beside the label; `required` alone draws nothing */
  requiredMarker?: boolean;
}

const {
  id,
  label,
  placeholder,
  options,
  tone = "light",
  requiredMarker = false,
  ...rest
} = Astro.props;
---

<div class:list={["field", tone]}>
  <label for={id}>
    <Text variant="title-base">
      {label}
      {
        requiredMarker && (
          <span class="marker" aria-hidden="true">
            *
          </span>
        )
      }
    </Text>
  </label>

  <div class="control">
    <select {...rest} {id} class="select">
      <option value="" disabled selected>{placeholder}</option>
      {
        options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))
      }
    </select>

    <svg
      class="chevron"
      viewBox="0 0 12 8"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M1 1.5 6 6.5 11 1.5Z"></path>
    </svg>
  </div>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    inline-size: 100%;
  }

  .control {
    position: relative;
    display: flex;
  }

  .marker {
    color: var(--color-text-error);
  }

  .select {
    inline-size: 100%;
    padding-block: var(--space-3);
    padding-inline: var(--space-4);
    padding-inline-end: var(--space-10);
    font: var(--paragraph-base);
    color: var(--color-text-on-light);
    border: 1px solid var(--color-border-light);
    border-block-end-width: 3px;
    border-radius: var(--radius-s);
    cursor: pointer;
    appearance: none;
  }

  .light .select {
    background: var(--color-fill-light);
  }

  .plain .select {
    background: transparent;
  }

  .select[aria-invalid="true"] {
    border-color: var(--color-border-error);
  }

  .select:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .select:focus-visible {
    outline: 2px solid var(--color-border-on-brand);
    outline-offset: 2px;
  }

  /* the placeholder is an option, so it cannot be styled through
     `::placeholder` — it is matched by value instead */
  .select:has(option[value=""]:checked) {
    color: var(--color-text-placeholder);
  }

  .chevron {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: var(--space-4);
    inline-size: 0.75rem;
    fill: var(--color-text-on-light);
    translate: 0 -50%;
    pointer-events: none;
  }

  /* an option inherits the field's colour on some platforms, which would carry
     the placeholder grey into the open list */
  .select option {
    color: var(--color-text-on-light);
  }
</style>
