---
type Props = {
  align?: "center" | "left";
  height?: "full" | "l" | "m";
  width?: "content" | "article";
} & (
  | { background?: "image" }
  | { background: "gradient"; surface: "brand" | "vivid" }
);

const props = Astro.props;

const align = props.align ?? "center";
const height = props.height ?? "full";
const width = props.width ?? "content";
const isGradient = props.background === "gradient";

async function slotHtml(name: string) {
  if (!Astro.slots.has(name)) {
    return "";
  }

  return (await Astro.slots.render(name)).trim();
}

const columns = await slotHtml("columns");
const logo = columns ? "" : await slotHtml("logo");
const subheading = await slotHtml("subheading");
const actions = await slotHtml("actions");

const style = {
  ...(height === "full"
    ? {}
    : { "--cover-spacing": `var(--space-section-${height})` }),
  ...(props.background === "gradient"
    ? { "--cover-surface": `var(--color-surface-${props.surface})` }
    : {}),
};
---

<section
  class:list={[
    "page-cover",
    align,
    height === "full" ? "full" : "sized",
    width,
    columns && "has-columns",
  ]}
  style={style}
>
  <div class:list={["media", isGradient && "gradient"]}>
    {!isGradient && <slot name="media" />}
  </div>

  <div class:list={["frame", logo && "with-logo", columns && "with-columns"]}>
    <div class="stack">
      <slot name="badge" />
      <slot name="heading" />

      {subheading && <div class="subheading" set:html={subheading} />}
      {actions && <div class="actions" set:html={actions} />}
    </div>

    {logo && <div class="logo" set:html={logo} />}
    {columns && <div class="columns" set:html={columns} />}
  </div>
</section>

<style>
  .page-cover {
    position: relative;
    display: grid;
    padding-block: var(--cover-pad-block);
    padding-inline: var(--space-6);
    place-items: center;
    overflow: hidden;
  }

  .full {
    --cover-pad-block: var(--space-10);

    min-block-size: 100svh;
  }

  .sized {
    --cover-pad-block: var(--cover-spacing);
  }

  /* three layers, top to bottom: the scrim (`::after`), the photo (the media
     slot), and the brand gradient below. The photo is opaque and covers, so
     the gradient only surfaces while the image is still loading or if it never
     arrives — the scrim stays over it either way, so that state degrades to
     the same palette rather than to bare color. */
  .media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--color-surface-brand);
  }

  .media.gradient {
    background-image: var(--cover-surface);
  }

  .media :global(picture),
  .media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .media:not(.gradient)::after {
    position: absolute;
    inset: 0;
    background-image: var(--color-overlay);
    content: "";
  }

  /* a grid item, so `z-index` applies without `position` — which matters, because the centered logo positions against the section, not the frame */
  .frame {
    z-index: 2;
    color: var(--color-text-on-media);
  }

  .center .frame {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-inline-size: var(--size-article);
  }

  .left .frame {
    inline-size: 100%;
    max-inline-size: var(--size-content);
  }

  .left.article .frame {
    max-inline-size: var(--size-article);
  }

  .left .with-logo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-10);
    align-items: center;
    justify-content: space-between;
  }

  .left .with-logo .stack {
    flex: 0 1 49%;
    min-inline-size: min(36.5rem, 100%);
    max-inline-size: none;
  }

  .left .with-logo .logo {
    flex: 0 1 31.75%;
    min-inline-size: min(12.5rem, 100%);
  }

  .left .with-columns {
    display: flex;
    gap: var(--space-24);
    align-items: center;
  }

  .left .with-columns .stack {
    flex: 1 1 auto;
  }

  /* the strip is drawn against the section's height, not the text's */
  .has-columns .frame {
    align-self: stretch;
  }

  .columns {
    display: none;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .center .stack {
    align-items: center;
    text-align: center;
  }

  .left .stack {
    align-items: flex-start;
    max-inline-size: min(100%, max(74.5%, 36.5rem));
    text-align: left;
  }

  .left.article .stack {
    max-inline-size: none;
  }

  .subheading {
    margin-block-start: calc(var(--space-4) - var(--space-2));
    color: var(--color-text-on-media-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-10);
  }

  .center .logo {
    position: absolute;
    inset-block-start: var(--space-10);
    inset-inline: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  /* 80rem — drifting strip shown. see styles/breakpoints.css */
  @media (width >= 80rem) {
    .columns {
      --drift-bleed: var(--cover-pad-block);

      /* a grid child stretches, which is how the strip picks the frame's height up */
      display: grid;
      flex: 0 0 544px;
      align-self: stretch;
    }

    .has-columns {
      min-block-size: 47.375rem;
    }
  }

  @media (height <= 40rem) {
    .center.full .logo {
      position: static;
      order: -1;
      margin-block-end: var(--space-6);
    }

    .center.full {
      place-content: center;
    }
  }
</style>
