---
type Props = {
  align?: "center" | "left";
  height?: "full" | "l" | "m";
} & (
  | { background?: "image" }
  | { background: "gradient"; surface: "brand" | "vivid" }
);

const props = Astro.props;

const align = props.align ?? "center";
const height = props.height ?? "full";
const isGradient = props.background === "gradient";

// only the wrappers that CSS needs a hook for are guarded: a bare `<slot>`
// renders no element when unfilled, but a wrapper div is still a flex/grid
// item and would leave a phantom track or `gap` behind.
//
// `Astro.slots.has` is not enough to guard them. The compiler emits a slot
// entry for `{cond && <el slot="x" />}` whether or not `cond` holds, so `has`
// answers true for a conditional slot that renders nothing — which is exactly
// how an optional logo or subheading gets passed. Ask what came out instead.
async function slotHtml(name: string) {
  if (!Astro.slots.has(name)) {
    return "";
  }

  return (await Astro.slots.render(name)).trim();
}

const logo = await slotHtml("logo");
const subheading = await slotHtml("subheading");
const actions = await slotHtml("actions");

const style = {
  ...(height === "full"
    ? {}
    : { "--cover-spacing": `var(--space-section-${height})` }),
  ...(props.background === "gradient"
    ? { "--cover-surface": `var(--color-surface-${props.surface})` }
    : {}),
};
---

<section
  class:list={["page-cover", align, height === "full" ? "full" : "sized"]}
  style={style}
>
  <div class:list={["media", isGradient && "gradient"]}>
    {!isGradient && <slot name="media" />}
  </div>

  <div class:list={["frame", logo && "with-logo"]}>
    {logo && <div class="logo" set:html={logo} />}

    <div class="stack">
      <slot name="badge" />
      <slot name="heading" />

      {subheading && <div class="subheading" set:html={subheading} />}
      {actions && <div class="actions" set:html={actions} />}
    </div>
  </div>
</section>

<style>
  .page-cover {
    position: relative;
    display: grid;
    place-items: center;
    padding-inline: var(--space-6);
    overflow: hidden;
  }

  /* svh, not vh: on mobile the cover must fit the visible viewport rather
     than sit partly under the browser chrome */
  .full {
    min-block-size: 100svh;
    padding-block: var(--space-10);
  }

  /* the shorter sizes have no floor: content plus padding decides the height,
     so there is no viewport unit left in play */
  .sized {
    padding-block: var(--cover-spacing);
  }

  /* three layers, top to bottom: the scrim (`::after`), the photo (the media
     slot), and the brand gradient below. The photo is opaque and covers, so
     the gradient only surfaces while the image is still loading or if it never
     arrives — the scrim stays over it either way, so that state degrades to
     the same palette rather than to bare color. */
  .media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--color-surface-brand);
  }

  /* a gradient cover is art-directed, so it needs neither the photo fallback
     nor the scrim: `--color-overlay` over `--gradient-vivid` only muddies the
     top band the design already controls */
  .media.gradient {
    background-image: var(--cover-surface);
  }

  .media :global(picture),
  .media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .media:not(.gradient)::after {
    position: absolute;
    inset: 0;
    background-image: var(--color-overlay);
    content: "";
  }

  /* a grid item, so `z-index` applies without `position` — which matters,
     because the centered logo positions against the section, not the frame */
  .frame {
    z-index: 2;
    color: var(--color-text-on-media);
  }

  .center .frame {
    display: flex;
    flex-direction: column;
    align-items: center;

    /* the cover frame's content width, 1036px */
    max-inline-size: 64.75rem;
  }

  .left .frame {
    inline-size: 100%;

    /* the venue cover frame is 1728px wide with 240px gutters, leaving
       1248px — which is `--size-content` exactly */
    max-inline-size: var(--size-content);
  }

  /* 612px text column and 396px logo, both from Figma. The 240px "gap" there
     is the leftover between the two at 1728px rather than a fixed gap, so
     `space-between` reproduces it and then degrades instead of overflowing. */
  .left .with-logo {
    display: grid;
    grid-template-columns: minmax(0, 38.25rem) minmax(0, 24.75rem);
    align-items: center;
    justify-content: space-between;
  }

  .left .with-logo .stack {
    grid-area: 1 / 1;
  }

  .left .with-logo .logo {
    grid-area: 1 / 2;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .center .stack {
    align-items: center;
    text-align: center;
  }

  /* the 612px measure is a typographic decision, so it holds whether or not
     the logo is there to take the other column */
  .left .stack {
    align-items: flex-start;
    max-inline-size: 38.25rem;
    text-align: left;
  }

  /* Figma nests the text column's gaps: 8px badge→heading (the `gap` above),
     16px heading→subheading, 40px →CTA. The subheading rule is the delta on
     top of the gap; `.actions` keeps the flat `--space-10` it has always had,
     which lands 8px over Figma — left alone so this change does not move the
     homepage. */
  .subheading {
    margin-block-start: calc(var(--space-4) - var(--space-2));
    color: var(--color-text-on-media-muted);
  }

  .actions {
    margin-block-start: var(--space-10);
  }

  .center .logo {
    position: absolute;
    inset-block-start: var(--space-10);
    inset-inline: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  /* the logo would collide with the stack once the viewport is short. Only
     `full` runs out of room — the other heights are sized by their content. */
  @media (height <= 40rem) {
    .center.full .logo {
      position: static;
      margin-block-end: var(--space-6);
    }

    .center.full {
      place-content: center;
    }
  }

  /* 60rem = "cover columns stacked" */
  @media (width < 60rem) {
    .left .with-logo {
      grid-template-columns: minmax(0, 38.25rem);
      gap: var(--space-10);
      justify-content: start;
    }

    .left .with-logo .logo {
      grid-area: 2 / 1;
    }
  }
</style>
