---
import TextBlock from "./TextBlock.astro";
import TwoBlocks from "./primitives/TwoBlocks.astro";
import Section from "./Section.astro";
import type { CtaLink, RichTextNode } from "./types";

interface Props {
  badge?: string;
  title: string;
  body: RichTextNode[];
  additionalCtas?: CtaLink[];
  cta?: CtaLink;
  ctaTone?: "red" | "blue";
}

const { badge, title, body, additionalCtas, cta, ctaTone } = Astro.props;
---

<Section spacing="l">
  <TwoBlocks>
    <div slot="first">
      <TextBlock
        {badge}
        {title}
        {body}
        {additionalCtas}
        {cta}
        {ctaTone}
        headingLevel="h2"
        size="l"
      />
    </div>

    <div slot="second"></div>
  </TwoBlocks>
</Section>
