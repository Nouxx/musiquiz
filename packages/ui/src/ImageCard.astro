---
import Badge from "./Badge.astro";
import Button from "./primitives/Button.astro";
import Card from "./primitives/Card.astro";
import RemoteImage from "./primitives/RemoteImage.astro";
import Text from "./primitives/Text.astro";
import type { CardItem } from "./types";

export type Props = CardItem & {
  size?: "large" | "small";
};

const { size = "large", media, badge, title, body, cta } = Astro.props;
---

<Card as="article" border="thin" class="card">
  <div class="media">
    <RemoteImage image={media} variant="card-media" />
    {
      cta && (
        // empty and hidden: the button carries this link for keyboards and
        // screen readers, and the image keeps its alt outside it
        <a href={cta.url} class="media-link" tabindex="-1" aria-hidden="true" />
      )
    }
  </div>

  <div class="content">
    <div class="stack">
      {badge && <Badge color="light">{badge}</Badge>}

      {
        title && (
          <Text as="h3" variant={size === "large" ? "title-h5" : "title-xl"}>
            {title}
          </Text>
        )
      }

      {
        body && (
          <div class="body">
            <Text as="p" variant="paragraph-base">
              {body}
            </Text>
          </div>
        )
      }
    </div>

    {
      cta && (
        <Button as="a" href={cta.url} tone="blue">
          {cta.label}
        </Button>
      )
    }
  </div>
</Card>

<style>
  /* the radius, the clip and the ring come from the shell; what is left here is
     the card's own fill and the column the media and the copy sit in */
  .card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .media {
    position: relative;
  }

  .media-link {
    position: absolute;
    inset: 0;
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-10);
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--space-6);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  /* Figma said #524B47 we used the nearest token --grey-600 (#655c57) here. */
  .body {
    color: var(--color-text-muted);
  }
</style>
