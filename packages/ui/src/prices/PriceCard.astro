---
import Badge from "../Badge.astro";
import Card from "../primitives/Card.astro";
import Text from "../primitives/Text.astro";
import type { PriceTier } from "../types";

interface Props extends PriceTier {
  class?: string;
}

const {
  label,
  labelIcon,
  price,
  currency,
  caption,
  note,
  class: className,
} = Astro.props;
---

<Card border="thick" class:list={["card", className]}>
  <Badge color="light" size="small" icon={labelIcon}>
    {label}
  </Badge>

  <div class="amount">
    <p class="price">
      <Text variant="title-h3">{price}</Text>
      {
        currency && (
          <span class="currency">
            <Text variant="title-xl">{currency}</Text>
          </span>
        )
      }
    </p>

    <Text as="p" variant="paragraph-base">
      {caption}
    </Text>
  </div>

  {
    note && (
      <Text as="p" variant="paragraph-base">
        {note}
      </Text>
    )
  }
</Card>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6);
    text-align: left;
  }

  .amount {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .price {
    margin: 0;
    white-space: nowrap;
  }

  .currency {
    margin-inline-start: var(--space-1);
  }

  .amount p:last-child {
    color: var(--color-text-muted);
    text-align: right;
  }
</style>
