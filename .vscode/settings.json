{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": ["apps/web"],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "astro"
  ],
  "stylelint.validate": ["css", "astro"],
  "cssVariables.lookupFiles": ["apps/web/src/styles/**/*.css"],
  "cssVariables.blacklistFolders": [
    "**/node_modules",
    "**/dist",
    "**/.astro",
    "**/.git"
  ],
  // VSCode does not consider ignored files when searching in a folder
  // so we need to manually exclude these paths
  "search.exclude": {
    "**/dist": true,
    "**/.astro": true,
    "**/.sanity": true,
    "**/.wrangler": true
  },
  "cSpell.words": ["zeptomail"]
}
